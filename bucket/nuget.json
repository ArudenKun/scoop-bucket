{
    "version": "6.9.1",
    "description": "The package manager for .NET.",
    "homepage": "https://www.nuget.org/",
    "license": "Apache-2.0",
    "url": "https://dist.nuget.org/win-x86-commandline/v6.9.1/NuGet.exe",
    "hash": "82bb13e2365e1e5ee7d0975618dcf90b279427de8a7ecb338b9b78bfc457d51b",
    "bin": "NuGet.exe",
    "env_set": {
        "NUGET_PACKAGES": "$dir\\data\\packages",
        "NUGET_HTTP_CACHE_PATH": "$dir\\data\\v3-cache",
        "NUGET_PLUGINS_CACHE_PATH": "$dir\\data\\plugins-cache"
    },
    "persist": "data",
    "checkver": {
        "url": "https://dist.nuget.org/index.json",
        "jsonpath": "$..versions[?(@.displayName == 'nuget.exe - recommended latest')].version"
    },
    "autoupdate": {
        "url": "https://dist.nuget.org/win-x86-commandline/v$version/NuGet.exe"
    }
}
