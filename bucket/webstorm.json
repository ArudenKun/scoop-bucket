{
    "version": "2022.3.2-223.8617.44",
    "description": "Cross-Platform IDE for JavaScript by JetBrains.",
    "homepage": "https://www.jetbrains.com/webstorm/",
    "license": {
        "identifier": "Proprietary",
        "url": "https://www.jetbrains.com/store/license.html"
    },
    "depends": "custom/jetcrack",
    "notes": "Activate Here: 'https://jetbrains.sussy.tech'",
    "url": "https://download.jetbrains.com/webstorm/WebStorm-2022.3.2.exe#/dl.7z",
    "hash": "ba07cb3086993dd7796b7186a57e182006d4214740c494139ba498c956a64d78",
    "installer": {
        "script": [
            "& \"$bucketsdir\\extras\\scripts\\jetbrains\\portable.ps1\" $dir $persist_dir",
            "if (!(Test-Path \"$persist_dir\\IDE\\bin\\datagrip64.exe.vmoptions\")) {",
            "   Add-Content $dir\\IDE\\bin\\webstorm64.exe.vmoptions -Value \"-javaagent:$scoopdir\\apps\\jetcrack\\current\\jetcrack.jar\"",
            "   Add-Content $dir\\IDE\\bin\\webstorm64.exe.vmoptions -Value \"--add-opens=java.base/jdk.internal.org.objectweb.asm=ALL-UNNAMED\"",
            "   Add-Content $dir\\IDE\\bin\\webstorm64.exe.vmoptions -Value \"--add-opens=java.base/jdk.internal.org.objectweb.asm.tree=ALL-UNNAMED\"",
            "}",
            "Remove-Item \"$dir\\IDE\\`$*\" -Force -Recurse"
        ]
    },
    "extract_to": "IDE",
    "bin": [
        [
            "IDE\\bin\\webstorm64.exe",
            "webstorm"
        ]
    ],
    "shortcuts": [
        [
            "IDE\\bin\\webstorm64.exe",
            "JetBrains\\WebStorm"
        ]
    ],
    "persist": [
        "IDE\\bin\\idea.properties",
        "IDE\\bin\\webstorm64.exe.vmoptions",
        "profile"
    ],
    "checkver": {
        "url": "https://data.services.jetbrains.com/products/releases?code=WS&latest=true&platform=zip&type=release",
        "regex": "version\":\"(?<ver>[\\d.]+)\".*\"build\":\"(?<build>[\\d.]+)\"",
        "replace": "${ver}-${build}"
    },
    "autoupdate": {
        "url": "https://download.jetbrains.com/webstorm/WebStorm-$matchHead.exe#/dl.7z",
        "hash": {
            "url": "$url.sha256"
        }
    }
}
