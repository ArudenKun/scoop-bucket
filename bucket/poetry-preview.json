{
    "version": "1.4.0",
    "description": "Dependency Management for Python",
    "homepage": "https://python-poetry.org/",
    "license": "MIT",
    "suggest": {
        "main": "python"
    },
    "url": "https://install.python-poetry.org#/install-poetry.py",
    "hash": "08a38ab8de719d4012af4d62c37ce09e84edce6e1c4da7c5ccbcade359312c8b",
    "pre_install": "if(!(Test-Path \"$persist_dir\\config.toml\")) { New-Item \"$dir\\config.toml\" -Value \"[virtualenvs]`nin-project = true\"| Out-Null }",
    "installer": {
        "script": [
            "$env:POETRY_HOME=\"$dir\"",
            "python3 \"$dir\\$fname\" --preview"
        ]
    },
    "bin": "venv\\Scripts\\poetry.exe",
    "env_set": {
        "POETRY_CACHE_DIR": "$dir\\cache",
        "POETRY_CONFIG_DIR": "$dir",
        "POETRY_DATA_DIR": "$dir"
    },
    "persist": [
        "cache",
        "config.toml"
    ],
    "checkver": {
        "url": "https://github.com/python-poetry/poetry/tags",
        "re": "/python-poetry/poetry/archive/refs/tags/(.+?).zip"
    },
    "autoupdate": {
        "url": "https://install.python-poetry.org#/install-poetry.py"
    }
}
