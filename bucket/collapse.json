{
    "version": "nightly",
    "homepage": "https://github.com/neon-nyan/Collapse",
    "license": "MIT",
    "url": "https://raw.githubusercontent.com/CollapseLauncher/Collapse/main/CollapseLauncher/icon.ico",
    "installer": {
        "script": [
            "try {",
            "   $url = 'https://api.github.com/repos/CollapseLauncher/Collapse/releases/latest'",
            "   $release_cont = $(Invoke-WebRequest $url).Content | ConvertFrom-Json",
            "   $link = $release_cont.assets[1].browser_download_url",
            "   $asset_name = $release_cont.assets[1].name",
            "   aria2c $link -d $dir",
            "   Expand-7zipArchive \"$dir\\$asset_name\" -Removal",
            "}",
            "catch { error $_.Exception.Message; throw }"
        ]
    },
    "shortcuts": [
        [
            "CollapseLauncher.exe",
            "Collapse"
        ]
    ],
    "##": [
        "url: https://github.com/neon-nyan/Collapse/releases/download/CL-v1.70.14/CL-1.70.14_Portable.7z"
    ],
    "notes": [
        "url: https://github.com/neon-nyan/Collapse/releases/download/CL-v$version/CL-$version_Portable.7z",
        "url: https://github.com/neon-nyan/Collapse/tags",
        "regex: /archive/refs/tags/CL-v([\\d.]+).zip"
    ]
}