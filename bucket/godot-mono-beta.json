{
    "version": "4.0-beta2",
    "description": "a feature-packed, cross-platform game engine to create 2D and 3D games from a unified interface.",
    "homepage": "https://godotengine.org/",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://downloads.tuxfamily.org/godotengine/4.0/beta2/mono/Godot_v4.0-beta2_mono_win64.zip",
            "hash": "sha512:e0f0b46a22ce83b3ebf91094eb54bae686a110c24495b84354866bfda306c2ec190fc2e94bd1bf95b4ab91e2d911b35b72ea97ac0d58dc8b255502024b15885a",
            "extract_dir": "Godot_v4.0-beta2_mono_win64"
        },
        "32bit": {
            "url": "https://downloads.tuxfamily.org/godotengine/4.0/beta2/mono/Godot_v4.0-beta2_mono_win32.zip",
            "hash": "sha512:da5e3ff6f2c5d933189e50f30de421bd319d8d5885b3a9e8c30246a4f40f605c6d8a52731e15ff956a02e12c76557a0cd38557abfd93c4be1fe7770e1d90d589",
            "extract_dir": "Godot_v4.0-beta2_mono_win64"
        }
    },
    "pre_install": [
        "Get-ChildItem \"$dir\\Godot_*.exe\" | Rename-Item -NewName \"$dir\\godot-mono-beta.exe\"",
        "New-Item -Force -Path \"$dir\" -Name '_sc_' -Value '{}' | Out-Null",
        "Remove-Item \"$dir\\Godot_*.cmd\""
    ],
    "bin": "godot-mono-beta.exe",
    "shortcuts": [
        [
            "godot-mono-beta.exe",
            "Godot Engine Beta (Mono)"
        ]
    ],
    "persist": "editor_data",
    "checkver": {
        "url": "https://godotengine.org/news",
        "regex": "Dev snapshot: Godot (?<ver>[\\d.]+) beta (?<beta>[\\d.]+)",
        "replace": "${1}-beta${2}"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://downloads.tuxfamily.org/godotengine/$matchVer/beta$matchBeta/mono/Godot_v$version_mono_win64.zip",
                "extract_dir": "Godot_v$version_mono_win64",
                "hash": {
                    "url": "$baseurl/SHA512-SUMS.txt"
                }
            },
            "32bit": {
                "url": "https://downloads.tuxfamily.org/godotengine/$matchVer/beta$matchBeta/mono/Godot_v$version_mono_win32.zip",
                "extract_dir": "Godot_v$version_mono_win64",
                "hash": {
                    "url": "$baseurl/SHA512-SUMS.txt"
                }
            }
        }
    }
}
