{
    "version": "4.0-beta3",
    "description": "a feature-packed, cross-platform game engine to create 2D and 3D games from a unified interface.",
    "homepage": "https://godotengine.org/",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://downloads.tuxfamily.org/godotengine/4.0/beta3/mono/Godot_v4.0-beta3_mono_win64.zip",
            "hash": "sha512:ab681cdc95ccb571a2fd839db3d83422f15a932577f7429770978307c27d53485a0c2b6a06fc6e670a56c9bc8c67c83a18c3132d895cc048279ebd2e4189d3e8",
            "extract_dir": "Godot_v4.0-beta3_mono_win64"
        },
        "32bit": {
            "url": "https://downloads.tuxfamily.org/godotengine/4.0/beta3/mono/Godot_v4.0-beta3_mono_win32.zip",
            "hash": "sha512:6949b8fb0625af9c02fbec78200c2743522f5af4f1075d2b2670238ac0d18091c6df9e272922cf64bee9d79b5cb902c8edd1604e92fc328b56fba8f10af3bb55",
            "extract_dir": "Godot_v4.0-beta3_mono_win32"
        }
    },
    "pre_install": [
        "Get-ChildItem \"$dir\\Godot_*.exe\" | Rename-Item -NewName \"$dir\\godot-mono-beta.exe\"",
        "New-Item -Force -Path \"$dir\" -Name '_sc_' -Value '{}' | Out-Null",
        "Remove-Item \"$dir\\Godot_*.cmd\""
    ],
    "bin": "godot-mono-beta.exe",
    "shortcuts": [
        [
            "godot-mono-beta.exe",
            "Godot Engine Beta (Mono)"
        ]
    ],
    "persist": "editor_data",
    "checkver": {
        "url": "https://godotengine.org/news",
        "regex": "Dev snapshot: Godot (?<ver>[\\d.]+) beta (?<beta>[\\d.]+)",
        "replace": "${1}-beta${2}"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://downloads.tuxfamily.org/godotengine/$matchVer/beta$matchBeta/mono/Godot_v$version_mono_win64.zip",
                "extract_dir": "Godot_v$version_mono_win64",
                "hash": {
                    "url": "$baseurl/SHA512-SUMS.txt"
                }
            },
            "32bit": {
                "url": "https://downloads.tuxfamily.org/godotengine/$matchVer/beta$matchBeta/mono/Godot_v$version_mono_win32.zip",
                "extract_dir": "Godot_v$version_mono_win32",
                "hash": {
                    "url": "$baseurl/SHA512-SUMS.txt"
                }
            }
        }
    }
}
