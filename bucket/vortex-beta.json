{
    "version": "2.8.0-beta.2",
    "description": "Open-source mod manager from Nexus Mods",
    "homepage": "https://nexusmods.com/about/vortex",
    "license": "GPL-3.0",
    "suggest": {
        "vcredist": "extras/vcredist2022",
        "windowsdesktop-runtime": "versions/windowsdesktop-runtime-6.0"
    },
    "url": "https://github.com/Nexus-Mods/Vortex/releases/download/v2.8.0-beta.2/vortex-setup-2.8.0-beta.2.exe",
    "hash": "sha512:63f21b8aa9c5c6ba97d7b2299a34cc7f6bc9ca558f5eef452f3fc95e4d7e9fa0a68ed27d15121b559d82bc28d1e3fb068256f34d23e640eda82a77d5afa1adc8",
    "pre_install": "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\"",
    "post_install": "Remove-Item \"$dir\\`$PLUGINSDIR\", \"$dir\\`$R0\", \"$dir\\`$TEMP\" -Recurse -Force",
    "shortcuts": [
        [
            "Vortex.exe",
            "Vortex"
        ]
    ],
    "checkver": {
        "github": "https://api.github.com/repos/Nexus-Mods/Vortex/releases",
        "jp": "$[?(@.prerelease == true)].tag_name",
        "re": "v?([\\d.]+-beta(?:\\.[\\da-zA-Z.-]+)?)"
    },
    "autoupdate": {
        "url": "https://github.com/Nexus-Mods/Vortex/releases/download/v$version/vortex-setup-$version.exe",
        "hash": {
            "url": "$baseurl/latest.yml",
            "regex": "sha512: $base64"
        }
    }
}
