{
    "version": "2.9.0-beta.4",
    "description": "Open-source mod manager from Nexus Mods",
    "homepage": "https://nexusmods.com/about/vortex",
    "license": "GPL-3.0",
    "suggest": {
        "vcredist": "extras/vcredist2022",
        "windowsdesktop-runtime": "versions/windowsdesktop-runtime-6.0"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/Nexus-Mods/Vortex/releases/download/v2.9.0-beta.4/vortex-setup-2.9.0-beta.4.exe#/dl.7z",
            "hash": "sha512:5472aeeb758ba01032c4f62b67dc66d80e5a5ae934d9c5134c4bb56f64dc65963ce8dcf5157e37d0cd5520602d3f510e7eb70080afba9626e90f276e1bffcbf2"
        }
    },
    "pre_install": "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\"",
    "post_install": "Remove-Item \"$dir\\`$PLUGINSDIR\", \"$dir\\`$R0\", \"$dir\\`$TEMP\" -Recurse -Force",
    "shortcuts": [
        [
            "Vortex.exe",
            "Vortex Beta"
        ]
    ],
    "checkver": {
        "github": "https://api.github.com/repos/Nexus-Mods/Vortex/releases",
        "jp": "$[?(@.prerelease == true)].tag_name",
        "re": "v?([\\d.]+-beta(?:\\.[\\da-zA-Z.-]+)?)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Nexus-Mods/Vortex/releases/download/v$version/vortex-setup-$version.exe#/dl.7z",
                "hash": {
                    "url": "$baseurl/latest.yml",
                    "regex": "sha512: $base64"
                }
            }
        }
    }
}
