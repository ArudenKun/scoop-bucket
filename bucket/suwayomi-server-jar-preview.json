    "checkver": {
        "script": [
            "try {",
            "   $url = 'https://github.com/Suwayomi/Suwayomi-Server-preview/releases'",
            "   $cont = Invoke-RestMethod -Uri $url",
            "   $match = [regex]::Match($cont, 'v(?<ver>([\\d.]+)-r(?<build>[\\d]+))').Groups[0].Value",
            "   Write-Output \"$match\"",
            "}",
            "catch { error $_.Exception.Message; throw }"
