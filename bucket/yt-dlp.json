{
    "version": "2024.07.08",
    "description": "A youtube-dl fork with additional features and fixes.",
    "homepage": "https://github.com/yt-dlp/yt-dlp",
    "license": "Unlicense",
    "suggest": {
        "ffmpeg": "ffmpeg"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/yt-dlp/yt-dlp/releases/download/2024.07.08/yt-dlp.exe",
            "hash": "sha512:a61b3b1c91fb417ca4e0fff3d47f531bf6f57745a844beb471fb347e098f96aaee91cd9542288b389431ddc28d3ac80a43f104df8442b07cb3c8d1a5b8f3e543"
        },
        "32bit": {
            "url": "https://github.com/yt-dlp/yt-dlp/releases/download/2024.07.08/yt-dlp_x86.exe#/yt-dlp.exe",
            "hash": "sha512:556d57e8a7c0585244e9832a187952a340c1fccce11d2ce4700e2781fef0d9c5b9d0b1ae8e1778697e2b95cacd6a41da287207ee530c9b426045374d889496af"
        }
    },
    "pre_install": "if (!(Test-Path \"$persist_dir\\yt-dlp.conf\")) { New-Item \"$dir\\yt-dlp.conf\" -ItemType File | Out-Null }",
    "bin": "yt-dlp.exe",
    "post_install": [
        "$config = Get-Content \"$dir\\yt-dlp.conf\"",
        "if (!($config -imatch \"--cache-dir\"))",
        "{",
        "   Add-Content $dir\\yt-dlp.conf -Value \"--cache-dir `\"$dir\\cache`\"\"",
        "}",
        "if (!($config -imatch \"-o \"))",
        "{",
        "   Add-Content $dir\\yt-dlp.conf -Value '-o ~/Downloads/%(title)s.%(ext)s'",
        "}"
    ],
    "persist": [
        "yt-dlp.conf",
        "ytdlp_plugins",
        "cache"
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/yt-dlp/yt-dlp/releases/download/$version/yt-dlp.exe"
            },
            "32bit": {
                "url": "https://github.com/yt-dlp/yt-dlp/releases/download/$version/yt-dlp_x86.exe#/yt-dlp.exe"
            }
        },
        "hash": {
            "url": "$baseurl/SHA2-512SUMS"
        }
    }
}
