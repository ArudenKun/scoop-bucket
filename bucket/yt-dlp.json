{
    "version": "2023.03.03",
    "description": "A youtube-dl fork with additional features and fixes.",
    "homepage": "https://github.com/yt-dlp/yt-dlp",
    "license": "Unlicense",
    "suggest": {
        "ffmpeg": "ffmpeg"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/yt-dlp/yt-dlp/releases/download/2023.03.03/yt-dlp.exe",
            "hash": "sha512:ccd0ec39251d55b81ba5d75c539d55379a2f1ccab6f43ad146b00c650b3aa6041f14f04f7357d9130dd96d7ddad37dcde488068ce8f9e75e9f0b170d0c1ba6bd"
        },
        "32bit": {
            "url": "https://github.com/yt-dlp/yt-dlp/releases/download/2023.03.03/yt-dlp_x86.exe#/yt-dlp.exe",
            "hash": "sha512:999bdc9e986f4c1516ee2e1ca660051fe19829aae0d535b961e18ea09e3514bd9fccbbe0521aa7fa9ed8b856ab16a65ea86764a01527f2d5a219a27dcef8a4d7"
        }
    },
    "pre_install": "if (!(Test-Path \"$persist_dir\\yt-dlp.conf\")) { New-Item \"$dir\\yt-dlp.conf\" -ItemType File | Out-Null }",
    "bin": "yt-dlp.exe",
    "post_install": [
        "$config = Get-Content \"$dir\\yt-dlp.conf\"",
        "if (!($config -imatch \"--cache-dir\"))",
        "{",
        "   Add-Content $dir\\yt-dlp.conf -Value \"--cache-dir `\"$dir\\cache`\"\"",
        "}",
        "if (!($config -imatch \"-o \"))",
        "{",
        "   Add-Content $dir\\yt-dlp.conf -Value '-o ~/Downloads/YouTube/%(title)s.%(ext)s'",
        "}"
    ],
    "persist": [
        "yt-dlp.conf",
        "cache"
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/yt-dlp/yt-dlp/releases/download/$version/yt-dlp.exe"
            },
            "32bit": {
                "url": "https://github.com/yt-dlp/yt-dlp/releases/download/$version/yt-dlp_x86.exe#/yt-dlp.exe"
            }
        },
        "hash": {
            "url": "$baseurl/SHA2-512SUMS"
        }
    }
}
