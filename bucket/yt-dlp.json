{
    "version": "2025.10.22",
    "description": "A youtube-dl fork with additional features and fixes.",
    "homepage": "https://github.com/yt-dlp/yt-dlp",
    "license": "Unlicense",
    "suggest": {
        "ffmpeg": "ffmpeg"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/yt-dlp/yt-dlp/releases/download/2025.10.22/yt-dlp.exe",
            "hash": "sha512:b286f563163cd2bf6c9e270062bdea4cd4cadd014c86b8f579bfa83fb998032beae2127b566909b1f8c1a3e3a55b646cf428258adf3b966da3de58a9a3dcbcee"
        },
        "32bit": {
            "url": "https://github.com/yt-dlp/yt-dlp/releases/download/2025.10.22/yt-dlp_x86.exe#/yt-dlp.exe",
            "hash": "sha512:6ccac69e2eee95b2a106e3534fc296ff85d8ef3c448e04bf4dce07b5a75bb81698a9c7258bfad0631e26ee1d44bb2dc502a7a9f217d4132799f3c6f8c88e1525"
        }
    },
    "pre_install": "if (!(Test-Path \"$persist_dir\\yt-dlp.conf\")) { New-Item \"$dir\\yt-dlp.conf\" -ItemType File | Out-Null }",
    "bin": "yt-dlp.exe",
    "post_install": [
        "$config = Get-Content \"$dir\\yt-dlp.conf\"",
        "if (!($config -imatch \"--cache-dir\"))",
        "{",
        "   Add-Content $dir\\yt-dlp.conf -Value \"--cache-dir `\"$dir\\cache`\"\"",
        "}",
        "if (!($config -imatch \"-o \"))",
        "{",
        "   Add-Content $dir\\yt-dlp.conf -Value '-o ~/Downloads/%(title)s.%(ext)s'",
        "}"
    ],
    "persist": [
        "yt-dlp.conf",
        "ytdlp_plugins",
        "cache"
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/yt-dlp/yt-dlp/releases/download/$version/yt-dlp.exe"
            },
            "32bit": {
                "url": "https://github.com/yt-dlp/yt-dlp/releases/download/$version/yt-dlp_x86.exe#/yt-dlp.exe"
            }
        },
        "hash": {
            "url": "$baseurl/SHA2-512SUMS"
        }
    }
}
