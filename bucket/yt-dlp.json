{
    "version": "2025.12.08",
    "description": "A youtube-dl fork with additional features and fixes.",
    "homepage": "https://github.com/yt-dlp/yt-dlp",
    "license": "Unlicense",
    "suggest": {
        "ffmpeg": "ffmpeg"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/yt-dlp/yt-dlp/releases/download/2025.12.08/yt-dlp.exe",
            "hash": "sha512:a069d2bb6f7c7ea2bc00745c6f734eaa507404ef8bd135a8d6e78afd92a8c1bf770389d7ae5ceb4eb8a17bfaefb7918d8ff4c4d1e36daa64e0ddbd6daafbf331"
        },
        "32bit": {
            "url": "https://github.com/yt-dlp/yt-dlp/releases/download/2025.12.08/yt-dlp_x86.exe#/yt-dlp.exe",
            "hash": "sha512:6d35a68f6175b53fec01fd6b0a0fec8910cb3ac2728d1e45a4c184c933a13640f2361762792341c27fd0a0d17337896dcbcaec830c52a1fe6d1068988e7f8042"
        }
    },
    "pre_install": "if (!(Test-Path \"$persist_dir\\yt-dlp.conf\")) { New-Item \"$dir\\yt-dlp.conf\" -ItemType File | Out-Null }",
    "bin": "yt-dlp.exe",
    "post_install": [
        "$config = Get-Content \"$dir\\yt-dlp.conf\"",
        "if (!($config -imatch \"--cache-dir\"))",
        "{",
        "   Add-Content $dir\\yt-dlp.conf -Value \"--cache-dir `\"$dir\\cache`\"\"",
        "}",
        "if (!($config -imatch \"-o \"))",
        "{",
        "   Add-Content $dir\\yt-dlp.conf -Value '-o ~/Downloads/%(title)s.%(ext)s'",
        "}"
    ],
    "persist": [
        "yt-dlp.conf",
        "ytdlp_plugins",
        "cache"
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/yt-dlp/yt-dlp/releases/download/$version/yt-dlp.exe"
            },
            "32bit": {
                "url": "https://github.com/yt-dlp/yt-dlp/releases/download/$version/yt-dlp_x86.exe#/yt-dlp.exe"
            }
        },
        "hash": {
            "url": "$baseurl/SHA2-512SUMS"
        }
    }
}
