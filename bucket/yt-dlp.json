{
    "version": "2025.01.26",
    "description": "A youtube-dl fork with additional features and fixes.",
    "homepage": "https://github.com/yt-dlp/yt-dlp",
    "license": "Unlicense",
    "suggest": {
        "ffmpeg": "ffmpeg"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/yt-dlp/yt-dlp/releases/download/2025.01.26/yt-dlp.exe",
            "hash": "sha512:374b873927c9b951f37d32fbfdd22e7277b41b1cce3b5675600c3d5593ef9996350cb645bb0930e38095f78da1cbcca7d1edcd1c432ced82a57cf74057195604"
        },
        "32bit": {
            "url": "https://github.com/yt-dlp/yt-dlp/releases/download/2025.01.26/yt-dlp_x86.exe#/yt-dlp.exe",
            "hash": "sha512:4da524bc5c2cfd3bea8c02afed711742baf0b1c77e99d5f889a7c161f595ff29a4a5d2c04a0ac8d5ad3e4d506eadd0eb1f20d567dae15a6b2a71a7a87f77787d"
        }
    },
    "pre_install": "if (!(Test-Path \"$persist_dir\\yt-dlp.conf\")) { New-Item \"$dir\\yt-dlp.conf\" -ItemType File | Out-Null }",
    "bin": "yt-dlp.exe",
    "post_install": [
        "$config = Get-Content \"$dir\\yt-dlp.conf\"",
        "if (!($config -imatch \"--cache-dir\"))",
        "{",
        "   Add-Content $dir\\yt-dlp.conf -Value \"--cache-dir `\"$dir\\cache`\"\"",
        "}",
        "if (!($config -imatch \"-o \"))",
        "{",
        "   Add-Content $dir\\yt-dlp.conf -Value '-o ~/Downloads/%(title)s.%(ext)s'",
        "}"
    ],
    "persist": [
        "yt-dlp.conf",
        "ytdlp_plugins",
        "cache"
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/yt-dlp/yt-dlp/releases/download/$version/yt-dlp.exe"
            },
            "32bit": {
                "url": "https://github.com/yt-dlp/yt-dlp/releases/download/$version/yt-dlp_x86.exe#/yt-dlp.exe"
            }
        },
        "hash": {
            "url": "$baseurl/SHA2-512SUMS"
        }
    }
}
