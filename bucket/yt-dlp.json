{
    "version": "2026.03.13",
    "description": "A youtube-dl fork with additional features and fixes.",
    "homepage": "https://github.com/yt-dlp/yt-dlp",
    "license": "Unlicense",
    "suggest": {
        "ffmpeg": "ffmpeg"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/yt-dlp/yt-dlp/releases/download/2026.03.13/yt-dlp.exe",
            "hash": "sha512:df666e41cf74ef401223064711a93fc4b89e9018b127654d963dbea97a80617e1b3903ea7f2c647abf06614fc4c626535912a952b12d607ea8b2968c01e712e7"
        },
        "32bit": {
            "url": "https://github.com/yt-dlp/yt-dlp/releases/download/2026.03.13/yt-dlp_x86.exe#/yt-dlp.exe",
            "hash": "sha512:b8e03d18e361b19f5769b160fb5e4fc4fdd6b29998f8d1e3af69491bdd6e092e14e30665589307b2ce36adad28b025b86e2c5bda27518d39bbe0713aba59db8c"
        }
    },
    "pre_install": "if (!(Test-Path \"$persist_dir\\yt-dlp.conf\")) { New-Item \"$dir\\yt-dlp.conf\" -ItemType File | Out-Null }",
    "bin": "yt-dlp.exe",
    "post_install": [
        "$config = Get-Content \"$dir\\yt-dlp.conf\"",
        "if (!($config -imatch \"--cache-dir\"))",
        "{",
        "   Add-Content $dir\\yt-dlp.conf -Value \"--cache-dir `\"$dir\\cache`\"\"",
        "}",
        "if (!($config -imatch \"-o \"))",
        "{",
        "   Add-Content $dir\\yt-dlp.conf -Value '-o ~/Downloads/%(title)s.%(ext)s'",
        "}"
    ],
    "persist": [
        "yt-dlp.conf",
        "ytdlp_plugins",
        "cache"
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/yt-dlp/yt-dlp/releases/download/$version/yt-dlp.exe"
            },
            "32bit": {
                "url": "https://github.com/yt-dlp/yt-dlp/releases/download/$version/yt-dlp_x86.exe#/yt-dlp.exe"
            }
        },
        "hash": {
            "url": "$baseurl/SHA2-512SUMS"
        }
    }
}
