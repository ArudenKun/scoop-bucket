{
    "version": "2024.07.09",
    "description": "A youtube-dl fork with additional features and fixes.",
    "homepage": "https://github.com/yt-dlp/yt-dlp",
    "license": "Unlicense",
    "suggest": {
        "ffmpeg": "ffmpeg"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/yt-dlp/yt-dlp/releases/download/2024.07.09/yt-dlp.exe",
            "hash": "sha512:05e8f60d6c8236b0de7f19d8b8f9fcbe4b5255b4a3a0cf9a7b2feff1d3ed25d4cd95bb7cc39bf2bcfe5a4d5d66d5dbd521a95d08be4d8824c5246ffb4414f17f"
        },
        "32bit": {
            "url": "https://github.com/yt-dlp/yt-dlp/releases/download/2024.07.09/yt-dlp_x86.exe#/yt-dlp.exe",
            "hash": "sha512:9821a57d2d82a44a084fcfcca58b7d434597071e0b4c4400f22b980633c444b399339ef9d24ffb281c756331a2b56248bc3bc294e76bfaa67a7d78d5751daa89"
        }
    },
    "pre_install": "if (!(Test-Path \"$persist_dir\\yt-dlp.conf\")) { New-Item \"$dir\\yt-dlp.conf\" -ItemType File | Out-Null }",
    "bin": "yt-dlp.exe",
    "post_install": [
        "$config = Get-Content \"$dir\\yt-dlp.conf\"",
        "if (!($config -imatch \"--cache-dir\"))",
        "{",
        "   Add-Content $dir\\yt-dlp.conf -Value \"--cache-dir `\"$dir\\cache`\"\"",
        "}",
        "if (!($config -imatch \"-o \"))",
        "{",
        "   Add-Content $dir\\yt-dlp.conf -Value '-o ~/Downloads/%(title)s.%(ext)s'",
        "}"
    ],
    "persist": [
        "yt-dlp.conf",
        "ytdlp_plugins",
        "cache"
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/yt-dlp/yt-dlp/releases/download/$version/yt-dlp.exe"
            },
            "32bit": {
                "url": "https://github.com/yt-dlp/yt-dlp/releases/download/$version/yt-dlp_x86.exe#/yt-dlp.exe"
            }
        },
        "hash": {
            "url": "$baseurl/SHA2-512SUMS"
        }
    }
}
