{
    "version": "2025.09.26",
    "description": "A youtube-dl fork with additional features and fixes.",
    "homepage": "https://github.com/yt-dlp/yt-dlp",
    "license": "Unlicense",
    "suggest": {
        "ffmpeg": "ffmpeg"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/yt-dlp/yt-dlp/releases/download/2025.09.26/yt-dlp.exe",
            "hash": "sha512:bd4a14397f6d77a5af04e48cc688bcb340c428b64a424ebeefd1f433f2baa2ddc4f178c5a2efbcb84b81fd3d2e5ad9d34c9067b75134b8405b7ecb2052a74133"
        },
        "32bit": {
            "url": "https://github.com/yt-dlp/yt-dlp/releases/download/2025.09.26/yt-dlp_x86.exe#/yt-dlp.exe",
            "hash": "sha512:bc2309687b48d70044fa7afce4dd33d3de3c4131d0182f25326f0d48cf41be60c1587457b5c96ef15ac02a76ba7e24a5e2a3d23f1c33b01e498e062425472bf1"
        }
    },
    "pre_install": "if (!(Test-Path \"$persist_dir\\yt-dlp.conf\")) { New-Item \"$dir\\yt-dlp.conf\" -ItemType File | Out-Null }",
    "bin": "yt-dlp.exe",
    "post_install": [
        "$config = Get-Content \"$dir\\yt-dlp.conf\"",
        "if (!($config -imatch \"--cache-dir\"))",
        "{",
        "   Add-Content $dir\\yt-dlp.conf -Value \"--cache-dir `\"$dir\\cache`\"\"",
        "}",
        "if (!($config -imatch \"-o \"))",
        "{",
        "   Add-Content $dir\\yt-dlp.conf -Value '-o ~/Downloads/%(title)s.%(ext)s'",
        "}"
    ],
    "persist": [
        "yt-dlp.conf",
        "ytdlp_plugins",
        "cache"
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/yt-dlp/yt-dlp/releases/download/$version/yt-dlp.exe"
            },
            "32bit": {
                "url": "https://github.com/yt-dlp/yt-dlp/releases/download/$version/yt-dlp_x86.exe#/yt-dlp.exe"
            }
        },
        "hash": {
            "url": "$baseurl/SHA2-512SUMS"
        }
    }
}
