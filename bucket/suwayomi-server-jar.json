{
    "version": "2.0.1727",
    "description": "A manga reader compatible with Tachiyomi extensions and backups",
    "homepage": "https://github.com/Suwayomi/Suwayomi-Server",
    "license": {
        "identifier": "MPL-2.0",
        "url": "https://github.com/Suwayomi/Suwayomi-Server/blob/master/LICENSE"
    },
    "architecture": {
        "64bit": {
            "url": [
                "https://github.com/Suwayomi/Suwayomi-Server/releases/download/v2.0.1727/Suwayomi-Server-v2.0.1727-windows-x64.zip",
                "https://raw.githubusercontent.com/Suwayomi/Suwayomi-Server/master/server/src/main/resources/icon/faviconlogo.ico"
            ],
            "hash": [
                "54ec294058db8c7f0e9702814cd9e338d37bd2ca761084296d921ccb257fa2b7",
                "3e5b32450bc8659f41b5da5b85a246d8e500ea5b93c917abb8032e6f80068550"
            ]
        }
    },
    "pre_install": [
        "Set-Content -Path \"$dir\\suwayomi-server-console.bat\" -Value \"@start /b java -Dsuwayomi.tachidesk.config.server.rootDir=$dir\\data -jar %~dp0Suwayomi-Server.jar\" -Encoding Ascii",
        "Set-Content -Path \"$dir\\suwayomi-server.bat\" -Value \"@start /b javaw -Dsuwayomi.tachidesk.config.server.rootDir=$dir\\data -jar %~dp0Suwayomi-Server.jar\" -Encoding Ascii"
    ],
    "bin": [
        "suwayomi-server-console.bat",
        "suwayomi-server.bat"
    ],
    "shortcuts": [
        [
            "suwayomi-server-console.bat",
            "Suwayomi Server",
            "",
            "faviconlogo.ico"
        ]
    ],
    "persist": "data",
    "checkver": {
        "url": "https://api.github.com/repos/Suwayomi/Suwayomi-Server/releases/latest",
        "jsonpath": "$..browser_download_url",
        "regex": "Suwayomi-Server-v([\\d.]+)-windows-x64\\.zip"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": [
                    "https://github.com/Suwayomi/Suwayomi-Server/releases/download/v$version/Suwayomi-Server-v$version-windows-x64.zip",
                    "https://raw.githubusercontent.com/Suwayomi/Suwayomi-Server/master/server/src/main/resources/icon/faviconlogo.ico"
                ],
                "extract_dir": "Suwayomi-Server-v$version-windows-x64"
            }
        },
        "hash": [
            {
                "url": "$baseurl/Checksums.sha256"
            },
            {
                "mode": "download"
            }
        ]
    }
}
