{
    "version": "2.1.1867",
    "description": "A manga reader compatible with Tachiyomi extensions and backups",
    "homepage": "https://github.com/Suwayomi/Suwayomi-Server",
    "license": {
        "identifier": "MPL-2.0",
        "url": "https://github.com/Suwayomi/Suwayomi-Server/blob/master/LICENSE"
    },
    "architecture": {
        "64bit": {
            "url": [
                "https://github.com/Suwayomi/Suwayomi-Server/releases/download/v2.1.1867/Suwayomi-Server-v2.1.1867.jar",
                "https://raw.githubusercontent.com/Suwayomi/Suwayomi-Server/master/server/src/main/resources/icon/faviconlogo.ico"
            ],
            "hash": [
                "51e307c2581e4e1a002991ab3e3a77503c8b074c42695987a984a7382d0ac5af",
                "3e5b32450bc8659f41b5da5b85a246d8e500ea5b93c917abb8032e6f80068550"
            ]
        }
    },
    "pre_install": [
        "Set-Content -Path \"$dir\\suwayomi-server-console.bat\" -Value \"@start /b java -Dsuwayomi.tachidesk.config.server.rootDir=`\"$dir\\data`\" -jar %~dp0Suwayomi-Server-v$version.jar\" -Encoding Ascii",
        "Set-Content -Path \"$dir\\suwayomi-server.bat\" -Value \"@start /b javaw -Dsuwayomi.tachidesk.config.server.rootDir=`\"$dir\\data`\" -jar %~dp0Suwayomi-Server-v$version.jar\" -Encoding Ascii"
    ],
    "post_install": [
        "(Get-Content -Path \"$dir\\suwayomi-server-console.bat\") -replace '\\\\', '/' | Set-Content -Path \"$dir\\suwayomi-server-console.bat\" -Encoding Ascii",
        "(Get-Content -Path \"$dir\\suwayomi-server.bat\") -replace '\\\\', '/' | Set-Content -Path \"$dir\\suwayomi-server.bat\" -Encoding Ascii"
    ],
    "bin": [
        "suwayomi-server-console.bat",
        "suwayomi-server.bat"
    ],
    "shortcuts": [
        [
            "suwayomi-server-console.bat",
            "Suwayomi Server",
            "",
            "faviconlogo.ico"
        ]
    ],
    "persist": "data",
    "checkver": {
        "url": "https://api.github.com/repos/Suwayomi/Suwayomi-Server/releases/latest",
        "jsonpath": "$..browser_download_url",
        "regex": "Suwayomi-Server-v([\\d.]+)-windows-x64\\.zip"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": [
                    "https://github.com/Suwayomi/Suwayomi-Server/releases/download/v$version/Suwayomi-Server-v$version.jar",
                    "https://raw.githubusercontent.com/Suwayomi/Suwayomi-Server/master/server/src/main/resources/icon/faviconlogo.ico"
                ],
                "extract_dir": "Suwayomi-Server-v$version-windows-x64"
            }
        },
        "hash": [
            {
                "url": "$baseurl/Checksums.sha256"
            },
            {
                "mode": "download"
            }
        ]
    }
}
