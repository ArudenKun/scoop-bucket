{
    "version": "2.0.1727",
    "description": "A manga reader compatible with Tachiyomi extensions and backups",
    "homepage": "https://github.com/Suwayomi/Suwayomi-Server",
    "license": {
        "identifier": "MPL-2.0",
        "url": "https://github.com/Suwayomi/Suwayomi-Server/blob/master/LICENSE"
    },
    "architecture": {
        "64bit": {
            "url": [
                "https://github.com/Suwayomi/Suwayomi-Server/releases/download/v2.0.1727/Suwayomi-Server-v2.0.1727.jar",
                "https://raw.githubusercontent.com/Suwayomi/Suwayomi-Server/master/server/src/main/resources/icon/faviconlogo.ico"
            ],
            "hash": [
                "fa7abdfee43fdd78f28fca0a897ad3177e32ec883f23de6ca515a3c0f3fbf94c",
                "3e5b32450bc8659f41b5da5b85a246d8e500ea5b93c917abb8032e6f80068550"
            ]
        }
    },
    "pre_install": [
        "Set-Content -Path \"$dir\\suwayomi-server-console.ps1\" -Value 'Start-Process -NoNewWindow -FilePath \"java\" -ArgumentList \"-Dsuwayomi.tachidesk.config.server.rootDir=`\"$dir\\data`\"\", \"-jar\", \"$dir\\Suwayomi-Server-v$version.jar\"' -Encoding Ascii",
        "Set-Content -Path \"$dir\\suwayomi-server.ps1\" -Value 'Start-Process -WindowStyle Hidden -FilePath \"javaw\" -ArgumentList \"-Dsuwayomi.tachidesk.config.server.rootDir=`\"$dir\\data`\"\", \"-jar\", \"$dir\\Suwayomi-Server-v$version.jar\"' -Encoding Ascii"
    ],
    "bin": [
        "suwayomi-server-console.ps1",
        "suwayomi-server.ps1"
    ],
    "shortcuts": [
        [
            "suwayomi-server-console.ps1",
            "Suwayomi Server",
            "",
            "faviconlogo.ico"
        ]
    ],
    "persist": "data",
    "checkver": {
        "url": "https://api.github.com/repos/Suwayomi/Suwayomi-Server/releases/latest",
        "jsonpath": "$..browser_download_url",
        "regex": "Suwayomi-Server-v([\\d.]+)-windows-x64\\.zip"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": [
                    "https://github.com/Suwayomi/Suwayomi-Server/releases/download/v$version/Suwayomi-Server-v$version.jar",
                    "https://raw.githubusercontent.com/Suwayomi/Suwayomi-Server/master/server/src/main/resources/icon/faviconlogo.ico"
                ],
                "extract_dir": "Suwayomi-Server-v$version-windows-x64"
            }
        },
        "hash": [
            {
                "url": "$baseurl/Checksums.sha256"
            },
            {
                "mode": "download"
            }
        ]
    }
}
