{
    "version": "1.1.0",
    "description": "A manga reader compatible with Tachiyomi extensions and backups",
    "homepage": "https://github.com/Suwayomi/Suwayomi-Server",
    "license": {
        "identifier": "MPL-2.0",
        "url": "https://github.com/Suwayomi/Suwayomi-Server/blob/master/LICENSE"
    },
    "url": [
        "https://github.com/Suwayomi/Suwayomi-Server/releases/download/v1.1.0/Suwayomi-Server-v1.1.0-r1532.jar#/Suwayomi-Server.jar",
        "https://raw.githubusercontent.com/Suwayomi/Suwayomi-Server/master/server/src/main/resources/icon/faviconlogo.ico"
    ],
    "hash": [
        "c7877bd6b386038ee2784853cfbf56b70cb92d54604e50667a091cebecc91e6f",
        "fdeb95c131ea8041d6704a33e0f6a40fd59f0737be0434d1df1db1ac0e62d750"
    ],
    "pre_install": [
        "Set-Content -Path \"$dir\\suwayomi-server-console.bat\" -Value \"@start /b java -Dsuwayomi.tachidesk.config.server.rootDir=$dir\\data -jar %~dp0Suwayomi-Server.jar\" -Encoding Ascii",
        "Set-Content -Path \"$dir\\suwayomi-server.bat\" -Value \"@start /b javaw -Dsuwayomi.tachidesk.config.server.rootDir=$dir\\data -jar %~dp0Suwayomi-Server.jar\" -Encoding Ascii"
    ],
    "bin": [
        "suwayomi-server-console.bat",
        "suwayomi-server.bat"
    ],
    "shortcuts": [
        [
            "suwayomi-server-console.bat",
            "Suwayomi Server",
            "",
            "faviconlogo.ico"
        ]
    ],
    "persist": "data",
    "checkver": {
        "script": [
            "try {",
            "   $url = 'https://github.com/Suwayomi/Suwayomi-Server/releases'",
            "   $cont = Invoke-RestMethod -Uri $url",
            "   $match = [regex]::Match($cont, 'v(?<ver>([\\d.]+)-r(?<build>[\\d]+))').Groups[0].Value",
            "   Write-Output \"$match\"",
            "}",
            "catch { error $_.Exception.Message; throw }"
        ],
        "regex": "v([\\d.]+)-r(?<releasenumber>[\\d]+)"
    },
    "autoupdate": {
        "url": [
            "https://github.com/Suwayomi/Suwayomi-Server/releases/download/v$version/Suwayomi-Server-v$version-r$matchReleasenumber.jar#/Suwayomi-Server.jar",
            "https://raw.githubusercontent.com/Suwayomi/Suwayomi-Server/master/server/src/main/resources/icon/faviconlogo.ico"
        ]
    }
}
