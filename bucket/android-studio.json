{
    "version": "2021.2.1.16",
    "description": "The official IDE for Android development, which includes everything you need to build Android apps.",
    "homepage": "https://developer.android.com/studio/",
    "license": {
        "identifier": "Freeware",
        "url": "https://developer.android.com/studio/terms.html"
    },
    "url": "https://redirector.gvt1.com/edgedl/android/studio/ide-zips/2021.2.1.16/android-studio-2021.2.1.16-windows.zip",
    "hash": "78575a5b779d66630b757a32df0a26b8c052995623d649ed31787fb64eef14b1",
    "installer": {
        "script": [
            "Rename-Item -Path \"$dir\\android-studio\" -NewName 'IDE' -Force",
            "& \"$bucketsdir\\extras\\scripts\\jetbrains\\portable.ps1\" $dir $persist_dir"
        ]
    },
    "shortcuts": [
        [
            "IDE\\bin\\studio64.exe",
            "Android Studio"
        ]
    ],
    "env_set": {
        "ANDROID_HOME": "$dir\\sdk",
        "ANDROID_USER_HOME": "$dir\\profile\\.android"
    },
    "persist": [
        "IDE\\bin\\idea.properties",
        "IDE\\bin\\studio64.exe.vmoptions",
        "profile",
        "sdk"
    ],
    "checkver": "android-studio-([\\d.]+)-windows\\.zip",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://redirector.gvt1.com/edgedl/android/studio/ide-zips/$version/android-studio-$version-windows.zip"
            }
        }
    }
}
