{
    "##": "'rootfs' must be a 'real' directory (at least on Windows 10 RS4)",
    "version": "22010300",
    "description": "Install Devuan Linux as a WSL Instance",
    "homepage": "https://github.com/VPraharsha03/DevuanWSL",
    "license": "MIT",
    "notes": "Even when you are logging in as 'root', some operations (like service command) require Windows administrator privileges",
    "url": "https://github.com/VPraharsha03/DevuanWSL/releases/download/22010300/Devuan.zip",
    "hash": "b810146e9b5d589a15ff37289a5adba1afd8e027d5734d7078b335a8d5ff7cee",
    "post_install": [
        "$installable = $true",
        "if ($null -eq (Get-Command 'wslconfig' -ErrorAction SilentlyContinue)) {",
        "    warn 'WSL appears not to be enabled!'",
        "    warn 'Run ''Enable-WindowsOptionalFeature -Online -FeatureName Microsoft-Windows-Subsystem-Linux'''",
        "    warn 'from an elevated PowerShell. Restart your computer when prompted and reinstall DevuanWSL.'",
        "    $installable = $false",
        "}",
        "& \"$dir\\Devuan.exe\" 'isregd'",
        "if ($?) {",
        "    warn 'DevuanWsl is already registered'",
        "    $installable = $false",
        "}",
        "if ($installable) {",
        "    Copy-Item \"$dir\\Devuan.exe\" \"$persist_dir\\data\\Devuan.exe\"",
        "    $res = Invoke-ExternalCommand \"$persist_dir\\data\\Devuan.exe\" 'install', \"$dir\\rootfs.tar.gz\"",
        "    Remove-Item \"$persist_dir\\data\\Devuan.exe\" -Force",
        "    if(!$res) { error 'DevuanWsl installation failed!'; return }",
        "}",
        "Remove-Item \"$dir\\rootfs.tar.gz\" -Force"
    ],
    "uninstaller": {
        "script": [
            "if ($cmd -ne 'uninstall') { return }",
            "$res = Invoke-ExternalCommand \"$dir\\Devuan.exe\" 'isregd'",
            "if(!$res) { error 'DevuanWsl is not registered!'; return }",
            "Invoke-ExternalCommand \"$dir\\Devuan.exe\" 'clean', '-y' | Out-Null"
        ]
    },
    "bin": "Devuan.exe",
    "shortcuts": [
        [
            "Devuan.exe",
            "Devuan Linux"
        ]
    ],
    "persist": "data",
    "checkver": "github",
    "autoupdate": {
        "url": "https://github.com/VPraharsha03/DevuanWSL/releases/download/$version/Devuan.zip"
    }
}
