{
    "version": "1.15.1",
    "description": "Install and run Python applications in isolated environments",
    "homepage": "https://pipx.pypa.io/",
    "license": "MIT",
    "suggest": {
        "Python": "python"
    },
    "pre_install": "Set-Content -Value '@python \"%~dp0pipx.pyz\" %*' -Path \"$dir\\pipx.bat\"",
    "url": "https://github.com/pypa/pipx/releases/download/1.15.1/pipx.pyz",
    "hash": "b75f6cdf188244a590f17ac581a21ab73bdc5da22c56288ce1b66f60392c33de",
    "bin": "pipx.bat",
    "env_add_path": "data\\bin",
    "env_set": {
        "PIPX_HOME": "$dir\\data",
        "PIPX_BIN_DIR": "$dir\\data\\bin",
        "PIPX_MAN_DIR": "$dir\\data\\share\\man"
    },
    "persist": "data",
    "checkver": {
        "github": "https://github.com/pypa/pipx"
    },
    "autoupdate": {
        "url": "https://github.com/pypa/pipx/releases/download/$version/pipx.pyz"
    }
}
