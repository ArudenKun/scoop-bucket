{
    "version": "nightly",
    "description": "崩坏：星穹铁道脚本 | Honkai: Star Rail auto bot (简体中文/繁體中文/English/Español)",
    "homepage": "https://github.com/LmeSzinc/StarRailCopilot",
    "license": "GPL-3.0 License",
    "url": "https://raw.githubusercontent.com/LmeSzinc/StarRailCopilot/master/requirements.txt",
    "installer": {
        "script": [
            "try {",
            "   $url = 'https://api.github.com/repos/LmeSzinc/StarRailCopilot/releases/latest'",
            "   $release_cont = $(Invoke-WebRequest $url).Content | ConvertFrom-Json",
            "   $asset = $release_cont.assets | Where-Object { $_.name -match 'StarRailCopilot_\\d+\\.\\d+\\.\\d+_full\\.7z' }",
            "   if ($null -eq $asset) { throw 'No matching asset found' }",
            "   $link = $asset.browser_download_url",
            "   $asset_name = $asset.name",
            "   info \"Downloading $asset_name\"",
            "   aria2c $link -d $dir",
            "   info \"Extracting $asset_name\"",
            "   Expand-7zipArchive -Path \"$dir\\$asset_name\" -ExtractDir \"StarRailCopilot\" -Removal",
            "}",
            "catch { error $_.Exception.Message; throw }"
        ]
    },
    "shortcuts": [
        [
            "src.exe",
            "Star Rail Copilot"
        ]
    ],
    "persist": "config",
    "post_install": "Remove-Item $dir\\requirements.txt"
}