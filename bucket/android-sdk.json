{
    "version": "9477386",
    "description": "The official Android command line tools",
    "homepage": "https://developer.android.com/studio#command-tools",
    "license": {
        "identifier": "Freeware",
        "url": "https://developer.android.com/studio/terms.html"
    },
    "depends": [
        "adb",
        "java/temurin8-jdk"
    ],
    "url": "https://dl.google.com/android/repository/commandlinetools-win-9477386_latest.zip",
    "hash": "696431978daadd33a28841320659835ba8db8080a535b8f35e9e60701ab8b491",
    "extract_to": "cmdline-tools",
    "installer": {
        "script": [
            "Rename-Item \"$dir\\cmdline-tools\\cmdline-tools\" \"latest\"",
            "$BATCH_FILE = Get-Content \"$dir\\cmdline-tools\\latest\\bin\\sdkmanager.bat\"",
            "$BATCH_FILE_NEW = $BATCH_FILE -replace 'set JAVA_EXE=java.exe', \"set JAVA_EXE=`\"$(appdir temurin8-jdk)\\current\\java.exe`\"\"",
            "$BATCH_FILE_NEW | Set-Content \"$dir\\cmdline-tools\\latest\\bin\\sdkmanager.bat\""
        ]
    },
    "env_add_path": "cmdline-tools\\latest\\bin",
    "env_set": {
        "ANDROID_HOME": "$dir"
    },
    "persist": [
        ".knownPackages",
        "build-tools",
        "emulator",
        "extras",
        "licenses",
        "ndk",
        "patcher",
        "platforms",
        "skiaparser",
        "sources",
        "system-images"
    ],
    "post_install": [
        "if (Test-Path \"$(appdir adb $global)\") {",
        "    New-Item \"$dir\\platform-tools\" -ItemType Junction -Target \"$(appdir adb $global)\\current\\platform-tools\" | Out-Null",
        "}",
        "$build_tools_url = 'https://developer.android.com/studio/releases/build-tools'",
        "$build_tools_content = $(Invoke-WebRequest $build_tools_url).Content",
        "$build_tools_match = (Select-String 'Build Tools, Revision ([A-Za-z0-9]+(\\.[A-Za-z0-9]+)+)' -InputObject $build_tools_content).Matches.Groups[1].Value",
        "$platform_url = 'https://developer.android.com/studio/releases/platforms'",
        "$platform_content = $(Invoke-WebRequest $platform_url).Content",
        "$platform_match = (Select-String 'API level ([0-9]+)' -InputObject $build_tools_content).Matches.Groups[1].Value",
        "Write-Host $platform_match"
    ],
    "##": [
        "$platform_url = 'https://developer.android.com/studio/releases/platforms'",
        "$platform_content = $(Invoke-WebRequest $platform_url).Content",
        "$platform_match = (Select-String 'API level ([0-9]+)' -InputObject $build_tools_content).Matches.Groups[1].Value",
        "$build_tools_url = 'https://developer.android.com/studio/releases/build-tools'",
        "$build_tools_content = $(Invoke-WebRequest $build_tools_url).Content",
        "$build_tools_match = (Select-String 'Build Tools, Revision ([A-Za-z0-9]+(\\.[A-Za-z0-9]+)+)' -InputObject $build_tools_content).Matches.Groups[1].Value",
        "&\"$dir\\cmdline-tools\\latest\\bin\\sdkmanager.bat\" \"build-tools;$build_tools_match\"",
        "&\"$dir\\cmdline-tools\\latest\\bin\\sdkmanager.bat\" \"platforms;android-$platform_match\""
    ],
    "checkver": "commandlinetools-win-(\\d+)",
    "autoupdate": {
        "url": "https://dl.google.com/android/repository/commandlinetools-win-$version_latest.zip",
        "hash": {
            "url": "https://developer.android.com/studio",
            "regex": "commandlinetools-win(?:.*\\n){3}.*<td>($sha256)"
        }
    }
}
