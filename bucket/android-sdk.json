{
    "version": "11076708",
    "description": "The official Android command line tools",
    "homepage": "https://developer.android.com/studio#command-tools",
    "license": {
        "identifier": "Freeware",
        "url": "https://developer.android.com/studio/terms.html"
    },
    "depends": [
        "adb",
        "java/temurin8-jdk"
    ],
    "url": "https://dl.google.com/android/repository/commandlinetools-win-11076708_latest.zip",
    "hash": "4d6931209eebb1bfb7c7e8b240a6a3cb3ab24479ea294f3539429574b1eec862",
    "extract_to": "cmdline-tools",
    "installer": {
        "script": [
            "Rename-Item \"$dir\\cmdline-tools\\cmdline-tools\" \"latest\"",
            "$BATCH_FILE = Get-Content \"$dir\\cmdline-tools\\latest\\bin\\sdkmanager.bat\"",
            "$BATCH_FILE_NEW = $BATCH_FILE -replace 'set JAVA_EXE=java.exe', \"set JAVA_EXE=`\"$(appdir temurin8-jdk)\\current\\java.exe`\"\"",
            "$BATCH_FILE_NEW | Set-Content \"$dir\\cmdline-tools\\latest\\bin\\sdkmanager.bat\""
        ]
    },
    "env_add_path": "cmdline-tools\\latest\\bin",
    "env_set": {
        "ANDROID_HOME": "$dir"
    },
    "post_install": [
        "if (Test-Path \"$(appdir adb $global)\") {",
        "    New-Item \"$dir\\platform-tools\" -ItemType Junction -Target \"$(appdir adb $global)\\current\\platform-tools\" | Out-Null",
        "}",
        "if (!(Test-Path \"$persist_dir\\licenses\\*\")) {",
        "   New-Item \"$dir\\licenses\\android-sdk-license\" -Value \"`n24333f8a63b6825ea9c5514f83c2829b004d1fee\" | Out-Null",
        "   New-Item \"$dir\\licenses\\android-googletv-license\" -Value \"`n601085b94cd77f0b54ff86406957099ebe79c4d6\" | Out-Null",
        "   New-Item \"$dir\\licenses\\android-sdk-arm-dbt-license\" -Value \"`n859f317696f67ef3d7f30a50a5560e7834b43903\" | Out-Null",
        "   New-Item \"$dir\\licenses\\android-sdk-preview-license\" -Value \"`n84831b9409646a918e30573bab4c9c91346d8abd\" | Out-Null",
        "   New-Item \"$dir\\licenses\\google-gdk-license\" -Value \"`n33b6a2b64607f11b759f320ef9dff4ae5c47d97a\" | Out-Null",
        "   New-Item \"$dir\\licenses\\intel-android-extra-license\" -Value \"`nd975f751698a77b662f1254ddbeed3901e976f5a\" | Out-Null",
        "   New-Item \"$dir\\licenses\\mips-android-sysimage-license\" -Value \"`ne9acab5b5fbb560a72cfaecce8946896ff6aab9d\" | Out-Null",
        "}",
        "& \"$bucketsdir\\custom\\scripts\\google\\android\\android-sdk-setup.ps1\""
    ],
    "##": [
        "Info 'Searching for latest build-tools version'",
        "$build_tools_url = 'https://developer.android.com/studio/releases/build-tools'",
        "$build_tools_content = $(Invoke-WebRequest $build_tools_url).Content",
        "$build_tools_match = (Select-String 'Build Tools, Revision ([A-Za-z0-9]+(\\.[A-Za-z0-9]+)+)' -InputObject $build_tools_content).Matches.Groups[1].Value",
        "Info \"Downloading build-tools $build_tools_match\"",
        "&\"$dir\\cmdline-tools\\latest\\bin\\sdkmanager.bat\" \"build-tools;$build_tools_match\"",
        "Info 'Searching for latest platforms version'",
        "$platforms_url = 'https://apilevels.com/'",
        "$platforms_content = $(Invoke-WebRequest $platforms_url).Content",
        "$platforms_match = (Select-String 'Level ([0-9]+)' -InputObject $platforms_content).Matches.Groups[1].Value",
        "Info \"Downloading platforms $platforms_match\"",
        "& \"$dir\\cmdline-tools\\latest\\bin\\sdkmanager.bat\" \"platforms;android-$platforms_match\""
    ],
    "persist": [
        ".knownPackages",
        "build-tools",
        "emulator",
        "extras",
        "licenses",
        "ndk",
        "patcher",
        "platforms",
        "skiaparser",
        "sources",
        "system-images"
    ],
    "checkver": "commandlinetools-win-(\\d+)",
    "autoupdate": {
        "url": "https://dl.google.com/android/repository/commandlinetools-win-$version_latest.zip",
        "hash": {
            "url": "https://developer.android.com/studio",
            "regex": "commandlinetools-win(?:.*\\n){3}.*<td>($sha256)"
        }
    }
}
