{
    "version": "1.23.2",
    "description": "A secure runtime for JavaScript and TypeScript",
    "homepage": "https://deno.land",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/denoland/deno/releases/download/v1.23.2/deno-x86_64-pc-windows-msvc.zip",
            "hash": "ae8094ab21021592abc97107964994b4b87713819c6d29b7ab35eee300dc11e7"
        }
    },
    "bin": "deno.exe",
    "checkver": {
        "github": "https://github.com/denoland/deno"
    },
    "env_add_path": [
        "scripts\\bin"
    ],
    "env_set": {
        "DENO_DIR": "$dir\\cache",
        "DENO_INSTALL_ROOT": "$dir\\scripts"
    },
    "persist": [
        "cache",
        "scripts"
    ],
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/denoland/deno/releases/download/v$version/deno-x86_64-pc-windows-msvc.zip"
            }
        }
    },
    "notes": "Restart required for the ENV variables to reflect",
    "##": "if (!(Test-Path \"$persist_dir\\cache\")) { New-Item \"$dir\\cache\" -ItemType Directory | Out-Null }"
}
