{
    "version": "1.2.64",
    "description": "A simple, experimental Nintendo Switch emulator",
    "homepage": "https://ryujinx.org/",
    "license": {
        "identifier": "MIT",
        "url": "https://github.com/GreemDev/Ryujinx/blob/master/LICENSE.txt"
    },
    "depends": "switch-firmware",
    "architecture": {
        "64bit": {
            "url": "https://github.com/GreemDev/Ryujinx/releases/download/1.2.64/ryujinx-1.2.64-win_x64.zip",
            "hash": "66811b7f207bbf5b83fcf07e77eb2e04a742fb07acd6af1242df61d9dd5f3ea9"
        }
    },
    "extract_dir": "publish",
    "pre_install": [
        "if (!(Test-Path \"$persist_dir\")) {",
        "   New-item \"$persist_dir\\portable\" -ItemType Directory | Out-Null",
        "   if (Test-Path \"$env:APPDATA\\Ryujinx\") {",
        "       Write-host \"Migrating AppData...\" -ForegroundColor yellow",
        "       Copy-Item -Path \"$env:APPDATA\\Ryujinx\\*\" -Destination \"$persist_dir\\portable\" -Recurse",
        "       Remove-Item -Path \"$env:APPDATA\\Ryujinx\" -Recurse",
        "   }",
        "}"
    ],
    "bin": "Ryujinx.exe",
    "shortcuts": [
        [
            "Ryujinx.exe",
            "Ryujinx"
        ]
    ],
    "persist": "portable",
    "checkver": {
        "github": "https://github.com/GreemDev/Ryujinx"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/GreemDev/Ryujinx/releases/download/$version/ryujinx-$version-win_x64.zip"
            }
        }
    }
}
