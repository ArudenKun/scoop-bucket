{
    "version": "4.5.2-20250616-44a738",
    "description": "mmm lobster",
    "homepage": "https://github.com/justchokingaround/lobster",
    "license": "GPL-2.0-only",
    "url": "https://github.com/justchokingaround/lobster/raw/main/lobster.sh#/lobster",
    "hash": "732ca82c243b1a659d4c83a89648aa43eb4ec5227a329c3899344b123af6a76f",
    "bin": "lobster",
    "checkver": {
        "script": [
            "try {",
            "   $url = 'https://raw.githubusercontent.com/justchokingaround/lobster/main/lobster.sh'",
            "   $lobster_content = Invoke-RestMethod -Uri $url",
            "   $version = [regex]::Match($lobster_content, 'LOBSTER_VERSION=\"([^\"]+)\"').Groups[1].Value",
            "   $url2 = 'https://api.github.com/repos/justchokingaround/lobster/commits?path=lobster.sh&per_page=1'",
            "   $commit_content = $(Invoke-WebRequest $url2).Content | ConvertFrom-Json",
            "   if (!($commit_content.commit.committer.date)) { error \"Commit date not found in '$url2'\"; throw }",
            "   $update_date = $(Get-Date $commit_content.commit.committer.date).ToString('yyyyMMdd')",
            "   if (!($commit_content.sha)) { error \"Commit hash not found in '$url2'\"; throw }",
            "   $commit_sha = $($commit_content.sha).Substring(0, 6)",
            "   Write-Output \"$version-$update_date-$commit_sha\"",
            "}",
            "catch { error $_.Exception.Message; throw }"
        ],
        "regex": "([\\w.-]+)"
    },
    "autoupdate": {
        "url": "https://github.com/justchokingaround/lobster/raw/main/lobster.sh#/lobster"
    }
}
