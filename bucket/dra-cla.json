{
    "version": "3.0.3-20240607-24d7ea",
    "description": "A cli tool to browse and play korean drama, chinese drama",
    "homepage": "https://github.com/CoolnsX/dra-cla",
    "license": "GPL-3.0-or-later",
    "url": "https://github.com/CoolnsX/dra-cla/raw/main/dra-cla",
    "hash": "32407da96cb10e525ec113e2a004f72260c0df465b87d4b530213aa2b5c8b847",
    "depends": "fzf",
    "bin": "dra-cla",
    "checkver": {
        "script": [
            "try {",
            "   $url = 'https://github.com/CoolnsX/dra-cla/raw/main/dra-cla'",
            "   $cont = Invoke-RestMethod -Uri $url",
            "   $version = [regex]::Match($cont, 'VERSION=\"([^\"]+)\"').Groups[1].Value",
            "   $url2 = 'https://api.github.com/repos/CoolnsX/dra-cla/commits?path=dra-cla&per_page=1'",
            "   $commit_cont = $(Invoke-WebRequest $url2).Content | ConvertFrom-Json",
            "   if (!($commit_cont.commit.committer.date)) { error \"Commit date not found in '$url2'\"; throw }",
            "   $update_date = $(Get-Date $commit_cont.commit.committer.date).ToString('yyyyMMdd')",
            "   if (!($commit_cont.sha)) { error \"Commit hash not found in '$url2'\"; throw }",
            "   $commit_sha = $($commit_cont.sha).Substring(0, 6)",
            "   Write-Output \"$version-$update_date-$commit_sha\"",
            "}",
            "catch { error $_.Exception.Message; throw }"
        ],
        "regex": "([\\w.-]+)"
    },
    "autoupdate": {
        "url": "https://github.com/CoolnsX/dra-cla/raw/main/dra-cla"
    }
}
