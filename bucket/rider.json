{
    "version": "2022.2.1-222.3739.37",
    "description": "Cross-Platform IDE for .NET by JetBrains.",
    "homepage": "https://www.jetbrains.com/rider/",
    "license": {
        "identifier": "Proprietary",
        "url": "https://www.jetbrains.com/store/license.html"
    },
    "depends": "custom/ja-netfilter",
    "notes": "Get key here: https://3.jetbra.in/",
    "url": "https://download.jetbrains.com/rider/JetBrains.Rider-2022.2.1.win.zip",
    "hash": "5787881661548c45e347186ed597619c0eb24f16cf9824784c28323ffa5aa311",
    "installer": {
        "script": [
            "& \"$bucketsdir\\extras\\scripts\\jetbrains\\portable.ps1\" $dir $persist_dir",
            "if (!(Test-Path \"$persist_dir\\rider64.exe.vmoptions\")) {",
            "   Add-Content $dir\\IDE\\bin\\rider64.exe.vmoptions -Value \"-javaagent:$scoopdir\\apps\\ja-netfilter\\current\\ja-netfilter.jar=jetbrains\"",
            "   Add-Content $dir\\IDE\\bin\\rider64.exe.vmoptions -Value \"--add-opens=java.base/jdk.internal.org.objectweb.asm=ALL-UNNAMED\"",
            "   Add-Content $dir\\IDE\\bin\\rider64.exe.vmoptions -Value \"--add-opens=java.base/jdk.internal.org.objectweb.asm.tree=ALL-UNNAMED\"",
            "}"
        ]
    },
    "extract_to": "IDE",
    "bin": [
        [
            "IDE\\bin\\rider64.exe",
            "rider"
        ]
    ],
    "shortcuts": [
        [
            "IDE\\bin\\rider64.exe",
            "JetBrains\\Rider"
        ]
    ],
    "persist": [
        "IDE\\bin\\idea.properties",
        "IDE\\bin\\rider64.exe.vmoptions",
        "profile"
    ],
    "checkver": {
        "url": "https://data.services.jetbrains.com/products/releases?code=RD&latest=true&platform=zip&type=release",
        "regex": "version\":\"(?<ver>[\\d.]+)\".*\"build\":\"(?<build>[\\d.]+)\"",
        "replace": "${ver}-${build}"
    },
    "autoupdate": {
        "url": "https://download.jetbrains.com/rider/JetBrains.Rider-$matchHead.win.zip",
        "hash": {
            "url": "$url.sha256"
        }
    }
}
