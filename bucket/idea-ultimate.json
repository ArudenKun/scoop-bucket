{
    "version": "2022.3.2-223.8617.56",
    "description": "Cross-Platform IDE for Java by JetBrains.",
    "homepage": "https://www.jetbrains.com/idea/",
    "license": {
        "identifier": "Proprietary",
        "url": "https://www.jetbrains.com/store/license.html"
    },
    "depends": "custom/jetcrack",
    "notes": "Activate Here: 'https://jetbrains.sussy.tech'",
    "url": "https://download.jetbrains.com/idea/ideaIU-2022.3.2.win.zip",
    "hash": "050a236427715e8cccfea74548bd48a54704fb1768446258d7fca33445933c90",
    "installer": {
        "script": [
            "& \"$bucketsdir\\extras\\scripts\\jetbrains\\portable.ps1\" $dir $persist_dir",
            "if (!(Test-Path \"$persist_dir\\IDE\\bin\\idea64.exe.vmoptions\")) {",
            "   Add-Content $dir\\IDE\\bin\\idea64.exe.vmoptions -Value \"-javaagent:$scoopdir\\apps\\jetcrack\\current\\jetcrack.jar\"",
            "   Add-Content $dir\\IDE\\bin\\idea64.exe.vmoptions -Value \"--add-opens=java.base/jdk.internal.org.objectweb.asm=ALL-UNNAMED\"",
            "   Add-Content $dir\\IDE\\bin\\idea64.exe.vmoptions -Value \"--add-opens=java.base/jdk.internal.org.objectweb.asm.tree=ALL-UNNAMED\"",
            "}"
        ]
    },
    "extract_to": "IDE",
    "bin": [
        [
            "IDE\\bin\\idea64.exe",
            "idea"
        ]
    ],
    "shortcuts": [
        [
            "IDE\\bin\\idea64.exe",
            "JetBrains\\IDEA Ultimate"
        ]
    ],
    "persist": [
        "IDE\\bin\\idea.properties",
        "IDE\\bin\\idea64.exe.vmoptions",
        "profile"
    ],
    "checkver": {
        "url": "https://data.services.jetbrains.com/products/releases?code=IIU&latest=true&platform=zip&type=release",
        "regex": "version\":\"(?<ver>[\\d.]+)\".*\"build\":\"(?<build>[\\d.]+)\"",
        "replace": "${ver}-${build}"
    },
    "autoupdate": {
        "url": "https://download.jetbrains.com/idea/ideaIU-$matchHead.win.zip",
        "hash": {
            "url": "$url.sha256"
        }
    }
}
