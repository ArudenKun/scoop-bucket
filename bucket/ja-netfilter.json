        ]
    },
    "post_install": "Remove-Item $dir\\config, $dir\\plugins -Force -Recurse",
    "checkver": {
        "url": "https://gitee.com/ja-netfilter/ja-netfilter/releases",
        "regex": "/ja-netfilter/ja-netfilter/tree/([\\d.]+)"
    },
    "autoupdate": {
        "url": "https://gitee.com/ja-netfilter/ja-netfilter/releases/download/$version/ja-netfilter-$version.zip",
        "hash": {
            "url": "https://gitee.com/ja-netfilter/ja-netfilter/releases",
            "regex": "sha1sum: <code>$sha1"
        }
    }
