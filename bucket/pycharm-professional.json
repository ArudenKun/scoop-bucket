{
    "version": "2025.2.2-252.26199.168",
    "description": "Cross-Platform IDE for Python by JetBrains.",
    "homepage": "https://www.jetbrains.com/pycharm/",
    "license": {
        "identifier": "Proprietary",
        "url": "https://www.jetbrains.com/store/license.html"
    },
    "depends": "alden/jetcrack",
    "url": "https://download.jetbrains.com/python/pycharm-professional-2025.2.2.exe#/dl.7z",
    "hash": "0112915ac545179f8a66728fbf9da99342a73372f440737d0f2cfae6a9bcf88e",
    "extract_to": "IDE",
    "installer": {
        "script": [
            "& \"$bucketsdir\\extras\\scripts\\jetbrains\\portable.ps1\" $dir $persist_dir",
            "Remove-Item \"$dir\\IDE\\`$*\" -Force -Recurse",
            "Set-Content \"$dir\\run_pycharm.bat\" \"start `\"`\" `\"$dir\\IDE\\bin\\pycharm64.exe`\"\" -Encoding ascii | Out-Null",
            "if (!(Test-Path \"$persist_dir\\IDE\\bin\\pycharm64.exe.vmoptions\")) {",
            "   Add-Content $dir\\IDE\\bin\\pycharm64.exe.vmoptions -Value \"-javaagent:$scoopdir\\apps\\jetcrack\\current\\jetcrack.jar\"",
            "   Add-Content $dir\\IDE\\bin\\pycharm64.exe.vmoptions -Value \"--add-opens=java.base/jdk.internal.org.objectweb.asm=ALL-UNNAMED\"",
            "   Add-Content $dir\\IDE\\bin\\pycharm64.exe.vmoptions -Value \"--add-opens=java.base/jdk.internal.org.objectweb.asm.tree=ALL-UNNAMED\"",
            "}"
        ]
    },
    "bin": [
        [
            "run_pycharm.bat",
            "pycharm"
        ]
    ],
    "shortcuts": [
        [
            "run_pycharm.bat",
            "JetBrains\\PyCharm Professional",
            "",
            "IDE\\bin\\pycharm64.exe"
        ]
    ],
    "persist": [
        "IDE\\bin\\idea.properties",
        "IDE\\bin\\pycharm64.exe.vmoptions",
        "profile"
    ],
    "checkver": {
        "url": "https://data.services.jetbrains.com/products/releases?code=PCP&latest=true&platform=zip&type=release",
        "regex": "version\":\"(?<ver>[\\d.]+)\".*\"build\":\"(?<build>[\\d.]+)\"",
        "replace": "${ver}-${build}"
    },
    "autoupdate": {
        "url": "https://download.jetbrains.com/python/pycharm-professional-$matchHead.exe#/dl.7z",
        "hash": {
            "url": "$url.sha256"
        }
    }
}
