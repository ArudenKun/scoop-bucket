        "replace": "${ver}-${build}"
    },
    "autoupdate": {
        "url": "https://github.com/tschoonj/GTK-for-Windows-Runtime-Environment-Installer/releases/download/$matchBuild/gtk3-runtime-$matchVer-$matchBuild-ts-win64.exe#/dl.7z"
