{
    "version": "1.22.6",
    "description": "An open source programming language that makes it easy to build simple, reliable, and efficient software.",
    "homepage": "https://golang.org",
    "license": "BSD-3-Clause",
    "notes": [
        "Your GOROOT has been set to: $dir",
        "You can run 'go env GOROOT' to view this at any time."
    ],
    "architecture": {
        "64bit": {
            "url": "https://dl.google.com/go/go1.22.6.windows-amd64.zip",
            "hash": "6023083a6e4d3199b44c37e9ba7b25d9674da20fd846a35ee5f9589d81c21a6a"
        },
        "32bit": {
            "url": "https://dl.google.com/go/go1.22.6.windows-386.zip",
            "hash": "eb734bacc9aabca1273b61dd392bb84a9bb33783f5e2fff2cd6ab9885bbefbe6"
        }
    },
    "extract_dir": "go",
    "bin": [
        "bin\\go.exe",
        "bin\\gofmt.exe"
    ],
    "env_add_path": "global-bin",
    "env_set": {
        "GOROOT": "$dir",
        "GOENV": "$dir\\data\\env"
    },
    "post_install": [
        "go env -w GOBIN=\"$dir\\global-bin\"",
        "go env -w GOPATH=\"$dir\\data\\modules\"",
        "go env -w GOCACHE=\"$dir\\data\\go-build\""
    ],
    "persist": "data",
    "checkver": {
        "url": "https://golang.org/dl/",
        "regex": "go([\\d.]+)\\.windows-"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://dl.google.com/go/go$version.windows-amd64.zip"
            },
            "32bit": {
                "url": "https://dl.google.com/go/go$version.windows-386.zip"
            }
        },
        "hash": {
            "url": "$url.sha256"
        }
    }
}
