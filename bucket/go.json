{
    "version": "1.25.6",
    "description": "An open source programming language that makes it easy to build simple, reliable, and efficient software.",
    "homepage": "https://golang.org",
    "license": "BSD-3-Clause",
    "notes": [
        "Your GOROOT has been set to: $dir",
        "You can run 'go env GOROOT' to view this at any time."
    ],
    "architecture": {
        "64bit": {
            "url": "https://dl.google.com/go/go1.25.6.windows-amd64.zip",
            "hash": "19b4733b727ba5c611b5656187f3ac367d278d64c3d4199a845e39c0fdac5335"
        },
        "32bit": {
            "url": "https://dl.google.com/go/go1.25.6.windows-386.zip",
            "hash": "873da5cec02b6657ecd5b85e562a38fb5faf1b6e9ea81b2eb0b9a9b5aea5cb35"
        }
    },
    "extract_dir": "go",
    "bin": [
        "bin\\go.exe",
        "bin\\gofmt.exe"
    ],
    "env_add_path": "global-bin",
    "env_set": {
        "GOROOT": "$dir",
        "GOENV": "$dir\\data\\env"
    },
    "post_install": [
        "go env -w GOBIN=\"$dir\\global-bin\"",
        "go env -w GOPATH=\"$dir\\data\\modules\"",
        "go env -w GOCACHE=\"$dir\\data\\go-build\""
    ],
    "persist": "data",
    "checkver": {
        "url": "https://golang.org/dl/",
        "regex": "go([\\d.]+)\\.windows-"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://dl.google.com/go/go$version.windows-amd64.zip"
            },
            "32bit": {
                "url": "https://dl.google.com/go/go$version.windows-386.zip"
            }
        },
        "hash": {
            "url": "$url.sha256"
        }
    }
}
