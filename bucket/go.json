{
    "version": "1.22.3",
    "description": "An open source programming language that makes it easy to build simple, reliable, and efficient software.",
    "homepage": "https://golang.org",
    "license": "BSD-3-Clause",
    "notes": [
        "Your GOROOT has been set to: $dir",
        "You can run 'go env GOROOT' to view this at any time."
    ],
    "architecture": {
        "64bit": {
            "url": "https://dl.google.com/go/go1.22.3.windows-amd64.zip",
            "hash": "cab2af6951a6e2115824263f6df13ff069c47270f5788714fa1d776f7f60cb39"
        },
        "32bit": {
            "url": "https://dl.google.com/go/go1.22.3.windows-386.zip",
            "hash": "f60f63b8a0885e0d924f39fd284aee5438fe87d8c3d8545a312adf43e0d9edac"
        }
    },
    "extract_dir": "go",
    "bin": [
        "bin\\go.exe",
        "bin\\gofmt.exe"
    ],
    "env_add_path": "global-bin",
    "env_set": {
        "GOROOT": "$dir",
        "GOENV": "$dir\\data\\env"
    },
    "post_install": [
        "go env -w GOBIN=\"$dir\\global-bin\"",
        "go env -w GOPATH=\"$dir\\data\\modules\"",
        "go env -w GOCACHE=\"$dir\\data\\go-build\""
    ],
    "persist": "data",
    "checkver": {
        "url": "https://golang.org/dl/",
        "regex": "go([\\d.]+)\\.windows-"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://dl.google.com/go/go$version.windows-amd64.zip"
            },
            "32bit": {
                "url": "https://dl.google.com/go/go$version.windows-386.zip"
            }
        },
        "hash": {
            "url": "$url.sha256"
        }
    }
}
