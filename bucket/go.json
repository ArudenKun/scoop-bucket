{
    "version": "1.20.3",
    "description": "An open source programming language that makes it easy to build simple, reliable, and efficient software.",
    "homepage": "https://golang.org",
    "license": "BSD-3-Clause",
    "notes": [
        "Your GOROOT has been set to: $dir",
        "You can run 'go env GOROOT' to view this at any time."
    ],
    "architecture": {
        "64bit": {
            "url": "https://dl.google.com/go/go1.20.3.windows-amd64.zip",
            "hash": "143a2837821c7dbacf7744cbb1a8421c1f48307c6fdfaeffc5f8c2f69e1b7932"
        },
        "32bit": {
            "url": "https://dl.google.com/go/go1.20.3.windows-386.zip",
            "hash": "37e9146e1f9d681cfcaa6fee6c7b890c44c64bc50228c9588f3c4231346d33bd"
        }
    },
    "extract_dir": "go",
    "bin": [
        "bin\\go.exe",
        "bin\\gofmt.exe"
    ],
    "env_add_path": "global-bin",
    "env_set": {
        "GOROOT": "$dir",
        "GOENV": "$dir\\data\\env"
    },
    "post_install": [
        "go env -w GOBIN=\"$dir\\global-bin\"",
        "go env -w GOPATH=\"$dir\\data\\modules\"",
        "go env -w GOCACHE=\"$dir\\data\\go-build\""
    ],
    "persist": "data",
    "checkver": {
        "url": "https://golang.org/dl/",
        "regex": "go([\\d.]+)\\.windows-"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://dl.google.com/go/go$version.windows-amd64.zip"
            },
            "32bit": {
                "url": "https://dl.google.com/go/go$version.windows-386.zip"
            }
        },
        "hash": {
            "url": "$url.sha256"
        }
    }
}
