{
    "version": "1.26.6",
    "description": "An open source programming language that makes it easy to build simple, reliable, and efficient software.",
    "homepage": "https://golang.org",
    "license": "BSD-3-Clause",
    "notes": [
        "Your GOROOT has been set to: $dir",
        "You can run 'go env GOROOT' to view this at any time."
    ],
    "architecture": {
        "64bit": {
            "url": "https://dl.google.com/go/go1.26.6.windows-amd64.zip",
            "hash": "5b6c5b556525810463b5c897b50dc7a82d6a3dc0bfaf55d990a7e9f31d6b2318"
        },
        "32bit": {
            "url": "https://dl.google.com/go/go1.26.6.windows-386.zip",
            "hash": "1e352f0a2488a880b76f26d5f82479cbd3b286ef360cbbdf53e26df5f623f82f"
        }
    },
    "extract_dir": "go",
    "bin": [
        "bin\\go.exe",
        "bin\\gofmt.exe"
    ],
    "env_add_path": "global-bin",
    "env_set": {
        "GOROOT": "$dir",
        "GOENV": "$dir\\data\\env"
    },
    "post_install": [
        "go env -w GOBIN=\"$dir\\global-bin\"",
        "go env -w GOPATH=\"$dir\\data\\modules\"",
        "go env -w GOCACHE=\"$dir\\data\\go-build\""
    ],
    "persist": "data",
    "checkver": {
        "url": "https://golang.org/dl/",
        "regex": "go([\\d.]+)\\.windows-"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://dl.google.com/go/go$version.windows-amd64.zip"
            },
            "32bit": {
                "url": "https://dl.google.com/go/go$version.windows-386.zip"
            }
        },
        "hash": {
            "url": "$url.sha256"
        }
    }
}
