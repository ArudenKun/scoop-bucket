    "license": "GPL-3.0-only",
    "url": "https://github.com/IridiumIO/CompactGUI/releases/download/v3.0.0-alpha.6/CompactGUI.exe",
    "hash": "9e0138f3330f524851c0eae6dc24499bbacd3eaee9fdd1418dac1c714e8bfcb7",
    "bin": "CompactGUI.exe",
    "shortcuts": [
        [
            "CompactGUI.exe",
            "CompactGUI Alpha"
        ]
    ],
    "checkver": {
        "url": "https://github.com/IridiumIO/CompactGUI/tags",
        "regex": "/archive/refs/tags/v(?<ver>\\d(\\.\\d)+)-alpha\\.(?<alpha>\\d)\\.zip",
        "replace": "${ver}-alpha.${alpha}"
    },
    "autoupdate": {
        "url": "https://github.com/IridiumIO/CompactGUI/releases/download/v$version/CompactGUI.exe",
        "hash": {
            "url": "https://github.com/IridiumIO/CompactGUI/releases/tag/v$version/",
            "regex": "SHA-256</span>:\\s+<span\\sclass=\"pl-s\">$sha256"
        }
    }
}
