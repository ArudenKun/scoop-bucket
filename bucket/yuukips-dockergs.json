{
    "version": "434349984",
    "description": "DockerGS is a container that run Grasscutter (anime game) with just a single command.",
    "homepage": "https://github.com/akbaryahya/DockerGS",
    "license": "AGPL-3.0",
    "depends": [
        "temurin17-jdk",
        "yuukips-resource"
    ],
    "url": "https://nightly.link/akbaryahya/DockerGS/actions/artifacts/434349984.zip",
    "hash": "fa9ab1de2e4bf285919ef13c0c9e3a58792404a9693895c268d2dbad6487d635",
    "pre_install": [
        "if (!(Test-Path \"persist_dir\\config.json\")) { New-Item -ItemType File config.json -Value '{}' | Out-Null }",
        "Set-Content \"$dir\\dockergs.bat\" 'java -jar \"%~dp0grasscutter.jar\" %1' -Encoding Ascii"
    ],
    "installer": {
        "script": [
            "if (!(Test-Path \"$persist_dir\\config.json\")) ",
            "{",
            "   \"$dir\\\" | Out-Null",
            "   $dockergs = Get-Process -Name java -ErrorAction SilentlyContinue",
            "   if (!$dockergs)",
            "   {",
            "       $config = Get-Content \"$dir\\config.json\" | ConvertFrom-Json",
            "       $config.folderStructure.resources = \"$(appdir yuukips-resource)\\current\\resources.zip\"",
            "       $config | ConvertTo-Json | Set-Content \"$dir\\config.json\"",
            "   }",
            "}"
        ]
    },
    "bin": "dockergs.bat",
    "persist": [
        "cache",
        "data",
        "logs",
        "plugins",
        "config.json"
    ],
    "checkver": {
        "url": "https://api.github.com/repos/akbaryahya/DockerGS/actions/artifacts",
        "jp": "$.artifacts[0].id"
    },
    "autoupdate": {
        "url": "https://nightly.link/akbaryahya/DockerGS/actions/artifacts/$version.zip"
    }
}
