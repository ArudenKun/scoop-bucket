{
    "version": "1.1.13",
    "description": "Dependency Management for Python",
    "homepage": "https://python-poetry.org/",
    "license": "MIT",
    "suggest": {
        "main": "python"
    },
    "url": "https://install.python-poetry.org#/install-poetry.py",
    "hash": "3e6e8ee8d8dc22c2a5bec5ecfb89a152f59dee77736c1491b3fe7dcc4a99df9f",
    "installer": {
        "script": [
            "python3 \"$dir\\$fname\" --version $version"
        ]
    },
    "bin": "venv\\Scripts\\poetry.exe",
    "env_set": {
        "POETRY_HOME": "$dir",
        "POETRY_VIRTUALENVS_IN_PROJECT": "true",
        "POETRY_CACHE_DIR": "$dir\\Cache",
        "POETRY_VIRTUALENVS_PATH": "$dir\\Cache\\virtualenvs"
    },
    "persist": [
        "Cache",
        "Cache\\virtualenvs"
    ],
    "checkver": {
        "github": "https://github.com/python-poetry/poetry/"
    },
    "autoupdate": {
        "url": "https://install.python-poetry.org#/install-poetry.py"
    }
}
