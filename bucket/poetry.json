{
    "version": "1.2.0",
    "description": "Dependency Management for Python",
    "homepage": "https://python-poetry.org/",
    "license": "MIT",
    "suggest": {
        "main": "python"
    },
    "url": "https://install.python-poetry.org#/install-poetry.py",
    "hash": "fd16592a208a76f378e11186db492ff283aeb6ef716b5b7455d65eec5424d74d",
    "pre_install": [
        "if(!(Test-Path \"$persist_dir\\config.toml\"))",
        "{",
        "   New-Item \"$dir\\config.toml\" -Value '[virtualenvs]`nin-project = true`nprefer-active-python = true' | Out-Null }",
        "}"
    ],
    "installer": {
        "script": [
            "$env:POETRY_HOME=\"$dir\"",
            "python3 \"$dir\\$fname\" --version $version"
        ]
    },
    "bin": "venv\\Scripts\\poetry.exe",
    "env_set": {
        "POETRY_CACHE_DIR": "$dir\\cache",
        "POETRY_CONFIG_DIR": "$dir",
        "POETRY_DATA_DIR": "$dir"
    },
    "persist": [
        "cache",
        "config.toml"
    ],
    "checkver": {
        "github": "https://github.com/python-poetry/poetry/"
    },
    "autoupdate": {
        "url": "https://install.python-poetry.org#/install-poetry.py"
    }
}
