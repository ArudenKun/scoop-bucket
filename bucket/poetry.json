{
    "version": "2.4.3",
    "description": "Dependency Management for Python",
    "homepage": "https://python-poetry.org/",
    "license": "MIT",
    "suggest": {
        "main": "python"
    },
    "url": "https://install.python-poetry.org#/install-poetry.py",
    "hash": "75745ca71373a7b22fa150953543f03d826a52f8e4bc4350328a33bddd668026",
    "pre_install": "if(!(Test-Path \"$persist_dir\\config.toml\")) { New-Item \"$dir\\config.toml\"  -ItemType File}",
    "installer": {
        "script": [
            "$env:POETRY_HOME=\"$dir\"",
            "python3 \"$dir\\$fname\" --version $version"
        ]
    },
    "bin": "venv\\Scripts\\poetry.exe",
    "env_set": {
        "POETRY_CACHE_DIR": "$dir\\cache",
        "POETRY_CONFIG_DIR": "$dir",
        "POETRY_DATA_DIR": "$dir"
    },
    "post_install": [
        "poetry config virtualenvs.prefer-active-python true",
        "poetry config virtualenvs.in-project true"
    ],
    "persist": [
        "cache",
        "config.toml"
    ],
    "checkver": {
        "github": "https://github.com/python-poetry/poetry/"
    },
    "autoupdate": {
        "url": "https://install.python-poetry.org#/install-poetry.py"
    }
}
