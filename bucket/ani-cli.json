{
    "version": "4.9.0-20240826-2f40d6",
    "description": "A cli to browse and watch anime (alone AND with friends). This tool scrapes the site allanime.",
    "homepage": "https://github.com/pystardust/ani-cli",
    "license": "GPL-3.0-or-later",
    "suggest": {
        "git": "git",
        "fzf": "fzf",
        "wget": "wget",
        "aria2": "aria2",
        "mpv": "extras/mpv",
        "ffmpeg": [
            "ffmpeg",
            "ffmpeg-shared"
        ]
    },
    "url": "https://raw.githubusercontent.com/pystardust/ani-cli/master/ani-cli",
    "hash": "301c4d4913b108e11902009aec5047d174fd5b8ea88e6c5b95117ea23f070300",
    "bin": "ani-cli",
    "env_set": {
        "ANI_CLI_HIST_DIR": "$dir\\data"
    },
    "persist": "data",
    "checkver": {
        "script": [
            "try {",
            "   $url = 'https://raw.githubusercontent.com/pystardust/ani-cli/master/ani-cli'",
            "   $cont = Invoke-RestMethod -Uri $url",
            "   $version = [regex]::Match($cont, 'version_number=\"([^\"]+)\"').Groups[1].Value",
            "   $url2 = 'https://api.github.com/repos/pystardust/ani-cli/commits?path=ani-cli&per_page=1'",
            "   $commit_cont = $(Invoke-WebRequest $url2).Content | ConvertFrom-Json",
            "   if (!($commit_cont.commit.committer.date)) { error \"Commit date not found in '$url2'\"; throw }",
            "   $update_date = $(Get-Date $commit_cont.commit.committer.date).ToString('yyyyMMdd')",
            "   if (!($commit_cont.sha)) { error \"Commit hash not found in '$url2'\"; throw }",
            "   $commit_sha = $($commit_cont.sha).Substring(0, 6)",
            "   Write-Output \"$version-$update_date-$commit_sha\"",
            "}",
            "catch { error $_.Exception.Message; throw }"
        ],
        "regex": "([\\w.-]+)"
    },
    "autoupdate": {
        "url": "https://raw.githubusercontent.com/pystardust/ani-cli/master/ani-cli"
    }
}
