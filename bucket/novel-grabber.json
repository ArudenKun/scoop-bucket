    "description": "Novel-Grabber can download novels from pretty much any webnovel and lightnovel site. ",
    "license": "MIT",
    "suggest": {
        "JDK": "java/openjdk"
    },
    "url": [
        "https://github.com/Flameish/Novel-Grabber/releases/latest/download/Novel-Grabber.zip",
        "https://github.com/ArudenKun/scoop-bucket-assets/raw/main/images/novel-grabber/icon.ico"
    ],
    "hash": [
        "4fc0e5007bfbd0373694aef32bccf1819b4a4c97cbcb315f21ee3c8aecd9b074",
        "01E8CA185D7FF8BAC2F0C02449A7A25258359871AD91A06EF77F2C7F07ED6A9C"
    ],
    "pre_install": [
        "if (!(Test-Path \"$dir\\NG-Launcher.bat\" ))",
        "{",
        "   New-Item -Force -Path \"$dir\\Novel-Grabber\\NG-Launcher.bat\" -Value \"@start java.exe -jar NG-Launcher.jar\"",
        "}",
        "if (!(Test-Path \"$persist_dir\\bin\\config.ini\")) { New-Item \"$dir\\Novel-Grabber\\bin\\config.ini\" | Out-Null }",
        "if (!(Test-Path \"$persist_dir\\bin\\library.json\")) { New-Item \"$dir\\Novel-Grabber\\bin\\library.json\" | Out-Null }",
        "if (!(Test-Path \"$persist_dir\\bin\\log.txt\")) { New-Item \"$dir\\Novel-Grabber\\bin\\log.txt\" | Out-Null }"
    ],
    "bin": "Novel-Grabber\\NG-Launcher.bat",
    "shortcuts": [
        [
            "Novel-Grabber\\NG-Launcher.bat",
            "Novel Grabber",
            "",
            "icon.ico"
        ]
    ],
    "persist": [
        "Novel-Grabber\\bin\\config.ini",
        "Novel-Grabber\\bin\\library.json",
        "Novel-Grabber\\bin\\log.txt"
    ],
    "checkver": {
        "regex": "Novel-Grabber (\\d(\\.\\d)+)"
    },
    "autoupdate": {
        "url": "https://github.com/Flameish/Novel-Grabber/releases/latest/download/Novel-Grabber.zip"
    }
}
