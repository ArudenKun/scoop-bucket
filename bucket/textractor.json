    "hash": "3efdcf390261fcfb6a44220113c68b06eba22a3ef441ac618208238b52ee7974",
    "pre_install": [
        "if (!(Test-Path \"$persist_dir\\Textractor\\x64\\SavedExtensions.txt\")) { New-Item \"$dir\\Textractor\\x64\\SavedExtensions.txt\" -Value \"Remove Repeated Characters>Copy to Clipboard>Extra Newlines>\" | Out-Null }",
        "if (!(Test-Path \"$persist_dir\\Textractor\\x86\\SavedExtensions.txt\")) { New-Item \"$dir\\Textractor\\x86\\SavedExtensions.txt\" -Value \"Remove Repeated Characters>Copy to Clipboard>Extra Newlines>\" | Out-Null }",
        "if (!(Test-Path \"$persist_dir\\Textractor\\x64\\SavedGames.txt\")) { New-Item \"$dir\\Textractor\\x64\\SavedGames.txt\" | Out-Null }",
        "if (!(Test-Path \"$persist_dir\\Textractor\\x86\\SavedGames.txt\")) { New-Item \"$dir\\Textractor\\x86\\SavedGames.txt\" | Out-Null }"
    ],
    "bin": [
        [
            "Textractor\\x64\\TextractorCLI.exe",
            "TextractorCLIx64"
        ],
        [
            "Textractor\\x86\\TextractorCLI.exe",
            "TextractorCLIx86"
        ]
    ],
    "shortcuts": [
        [
            "Textractor\\x64\\Textractor.exe",
            "Textractor-x64"
        ],
        [
            "Textractor\\x86\\Textractor.exe",
            "Textractor-x86"
        ]
    ],
    "persist": [
        "Textractor\\x64\\SavedExtensions.txt",
        "Textractor\\x64\\SavedGames.txt",
        "Textractor\\x86\\SavedExtensions.txt",
        "Textractor\\x86\\SavedGames.txt"
