    ],
    "pre_install": [
        "if (!(Test-Path \"$persist_dir\\config.json\")) { New-Item \"$dir\\config.json\" | Out-Null }",
        "if (!(Test-Path \"$persist_dir\\dockergc.bat\"))",
        "{",
        "   New-Item \"$dir\\dockergc.bat\" -Value '@start java -jar grasscutter.jar`n@start mongod' | Out-Null",
        "}"
    ],
    "installer": {
        "script": [
            "Expand-7zipArchive \"$dir\\dockergc.tar\" \"$dir\""
        ]
    },
    "extract_dir": [
        "work",
        "GrasscutterResources-2.8"
    ],
    "bin": "dockergc.bat",
    "post_install": "java -jar grasscutter.jar -handbook",
    "persist": [
        "data",
        "logs",
        "plugins",
        "config.json"
    ],
    "checkver": {
        "url": "https://api.github.com/repos/akbaryahya/DockerGC/actions/artifacts",
        "jp": "$.artifacts[0].id"
    },
