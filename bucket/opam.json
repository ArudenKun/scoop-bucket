{
    "version": "2.4.0",
    "description": "opam is a source-based package manager. It supports multiple simultaneous compiler installations, flexible package constraints, and a Git-friendly development workflow.",
    "homepage": "https://opam.ocaml.org/",
    "license": "LGPL-2.1-only",
    "suggest": {
        "Cygwin": "main/cygwin"
    },
    "depends": "main/wget",
    "url": "https://github.com/ocaml/opam/releases/download/2.4.0/opam-2.4.0-x86_64-windows.exe",
    "hash": "fb95167951efc4c7b195a8f50269b591f8227f171731fd081a30d5f2f7601a3f",
    "bin": "opam.exe",
    "env_set": {
        "OPAMROOT": "$dir\\data",
        "OPAMFETCH": "wget"
    },
    "persist": "data",
    "checkver": {
        "github": "https://github.com/ocaml/opam"
    },
    "autoupdate": {
