{
    "version": "2.3.0",
    "description": "opam is a source-based package manager. It supports multiple simultaneous compiler installations, flexible package constraints, and a Git-friendly development workflow.",
    "homepage": "https://opam.ocaml.org/",
    "license": "LGPL-2.1-only",
    "suggest": {
        "Cygwin": "main/cygwin"
    },
    "depends": "main/wget",
    "url": "https://github.com/ocaml/opam/releases/download/2.3.0/opam-2.3.0-x86_64-windows.exe",
    "hash": "925e7059ae6e5aefae729dd8ea66cd92b21450b50d8e6564d185443e41c1cd84",
    "bin": "opam.exe",
    "env_set": {
        "OPAMROOT": "$dir\\data",
        "OPAMFETCH": "wget"
    },
    "persist": "data",
    "checkver": {
        "github": "https://github.com/ocaml/opam"
    },
    "autoupdate": {
        "url": "https://github.com/ocaml/opam/releases/download/$version/opam-$version-x86_64-windows.exe"
    }
}
