{
    "version": "2.5.0",
    "description": "opam is a source-based package manager. It supports multiple simultaneous compiler installations, flexible package constraints, and a Git-friendly development workflow.",
    "homepage": "https://opam.ocaml.org/",
    "license": "LGPL-2.1-only",
    "suggest": {
        "Cygwin": "main/cygwin"
    },
    "depends": "main/wget",
    "url": "https://github.com/ocaml/opam/releases/download/2.5.0/opam-2.5.0-x86_64-windows.exe",
    "hash": "bb2f4fc1d13ea1ff66d8263c5c0f04412d0225030ed9ef5445d11f3d07b2f379",
    "bin": "opam.exe",
    "env_set": {
        "OPAMROOT": "$dir\\data",
        "OPAMFETCH": "wget"
