{
    "version": "2.6.0",
    "description": "opam is a source-based package manager. It supports multiple simultaneous compiler installations, flexible package constraints, and a Git-friendly development workflow.",
    "homepage": "https://opam.ocaml.org/",
    "license": "LGPL-2.1-only",
    "suggest": {
        "Cygwin": "main/cygwin"
    },
    "depends": "main/wget",
    "url": "https://github.com/ocaml/opam/releases/download/2.6.0/opam-2.6.0-x86_64-windows.exe",
    "hash": "69cb3078a43e8b9071e064a273573b6f3fffd2ed893da3d5f940842c6a50271e",
    "bin": "opam.exe",
    "env_set": {
        "OPAMROOT": "$dir\\data",
        "OPAMFETCH": "wget"
    },
    "persist": "data",
    "checkver": {
        "github": "https://github.com/ocaml/opam"
    },
    "autoupdate": {
