{
    "version": "3.5.2",
    "description": "a feature-packed, cross-platform game engine to create 2D and 3D games from a unified interface.",
    "homepage": "https://godotengine.org/",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/godotengine/godot/releases/download/3.5.2-stable/Godot_v3.5.2-stable_mono_win64.zip",
            "hash": "sha512:06b5de121e0deba642c05b1e8a933c070fe7da3158723f235992669e567d2c854ed03d456084b9e5da7f3c2727e0a2fd15d55d14e44a9f1e964954575705aee4",
            "extract_dir": "Godot_v3.5.1-stable_mono_win64"
        },
        "32bit": {
            "url": "https://github.com/godotengine/godot/releases/download/3.5.2-stable/Godot_v3.5.2-stable_mono_win32.zip",
            "hash": "sha512:530475b7e4bdc9a2119b95a98f16a26071d6f519b321450aec7d3dd7e48abea25c224db02d789edbc020f0b99d9d31f57c5121a05cb1acfcba567ff8e990b0f3",
            "extract_dir": "Godot_v3.5.1-stable_mono_win32"
        }
    },
    "pre_install": [
        "Remove-Item \"$dir\\Godot_*_console.*\"",
        "New-Item -Force -Path \"$dir\" -Name '_sc_' -Value '{}' | Out-Null",
        "Get-Item \"$dir\\Godot_*.exe\" | Rename-Item -NewName 'godot-mono.exe'"
    ],
    "bin": [
        [
            "godot-mono.exe",
            "godot3-mono.exe"
        ]
    ],
    "shortcuts": [
        [
            "godot-mono.exe",
            "Godot 3 Engine (Mono)"
        ]
    ],
    "persist": "editor_data",
    "checkver": {
        "url": "https://github.com/godotengine/godot/tags",
        "regex": "(3[\\d.]+)-stable"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/godotengine/godot/releases/download/$version-stable/Godot_v$version-stable_mono_win64.zip",
                "hash": {
                    "url": "$baseurl/SHA512-SUMS.txt"
                }
            },
            "32bit": {
                "url": "https://github.com/godotengine/godot/releases/download/$version-stable/Godot_v$version-stable_mono_win32.zip",
                "hash": {
                    "url": "$baseurl/SHA512-SUMS.txt"
                }
            }
        }
    }
}
