{
    "version": "2022.3.1.21",
    "description": "The official IDE for Android development, which includes everything you need to build Android apps.",
    "homepage": "https://developer.android.com/studio/",
    "license": {
        "identifier": "Freeware",
        "url": "https://developer.android.com/studio/terms.html"
    },
    "depends": "gradle-bin",
    "architecture": {
        "64bit": {
            "url": "https://redirector.gvt1.com/edgedl/android/studio/ide-zips/2022.3.1.21/android-studio-2022.3.1.21-windows.zip",
            "hash": "2f42dc50bf2a81d3c8770636bab5cdbdd4f10fb74987ec47b6aab03ba94155b5"
        }
    },
    "installer": {
        "script": [
            "Rename-Item -Path \"$dir\\android-studio\" -NewName 'IDE' -Force",
            "& \"$bucketsdir\\extras\\scripts\\jetbrains\\portable.ps1\" $dir $persist_dir"
        ]
    },
    "shortcuts": [
        [
            "IDE\\bin\\studio64.exe",
            "Android Studio"
        ]
    ],
    "env_set": {
        "ANDROID_HOME": "$dir\\sdk",
        "ANDROID_USER_HOME": "$dir\\profile\\.android"
    },
    "post_install": [
        "if(!(Test-Path \"$persist_dir\\sdk\\*\"))",
        "{",
        "   New-Item -Path \"$dir\\sdk\\build-tools\" -ItemType Directory | Out-Null",
        "   New-Item -Path \"$dir\\sdk\\emulator\" -ItemType Directory | Out-Null",
        "   New-Item -Path \"$dir\\sdk\\bextras\" -ItemType Directory | Out-Null",
        "   New-Item -Path \"$dir\\sdk\\licenses\" -ItemType Directory | Out-Null",
        "   New-Item -Path \"$dir\\sdk\\patcher\" -ItemType Directory | Out-Null",
        "   New-Item -Path \"$dir\\sdk\\platforms\" -ItemType Directory | Out-Null",
        "   New-Item -Path \"$dir\\sdk\\sources\" -ItemType Directory | Out-Null",
        "   New-Item -Path \"$dir\\sdk\\system-images\" -ItemType Directory | Out-Null",
        "   New-Item -Path \"$dir\\sdk\\tools\" -ItemType Directory | Out-Null",
        "}",
        "if (!(Test-Path \"$persist_dir\\sdk\\licenses\\*\")) {",
        "   New-Item \"$dir\\sdk\\licenses\\android-sdk-license\" -Value \"`n24333f8a63b6825ea9c5514f83c2829b004d1fee\" | Out-Null",
        "   New-Item \"$dir\\sdk\\licenses\\android-googletv-license\" -Value \"`n601085b94cd77f0b54ff86406957099ebe79c4d6\" | Out-Null",
        "   New-Item \"$dir\\sdk\\licenses\\android-sdk-arm-dbt-license\" -Value \"`n859f317696f67ef3d7f30a50a5560e7834b43903\" | Out-Null",
        "   New-Item \"$dir\\sdk\\licenses\\android-sdk-preview-license\" -Value \"`n84831b9409646a918e30573bab4c9c91346d8abd\" | Out-Null",
        "   New-Item \"$dir\\sdk\\licenses\\google-gdk-license\" -Value \"`n33b6a2b64607f11b759f320ef9dff4ae5c47d97a\" | Out-Null",
        "   New-Item \"$dir\\sdk\\licenses\\intel-android-extra-license\" -Value \"`nd975f751698a77b662f1254ddbeed3901e976f5a\" | Out-Null",
        "   New-Item \"$dir\\sdk\\licenses\\mips-android-sysimage-license\" -Value \"`ne9acab5b5fbb560a72cfaecce8946896ff6aab9d\" | Out-Null",
        "}"
    ],
    "persist": [
        "IDE\\bin\\idea.properties",
        "IDE\\bin\\studio64.exe.vmoptions",
        "profile",
        "sdk"
    ],
    "checkver": "android-studio-([\\d.]+)-windows\\.zip",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://redirector.gvt1.com/edgedl/android/studio/ide-zips/$version/android-studio-$version-windows.zip",
                "hash": {
                    "url": "https://developer.android.com/studio",
                    "regex": "$sha256 android-studio-$version-windows.zip"
                }
            }
        }
    }
}
