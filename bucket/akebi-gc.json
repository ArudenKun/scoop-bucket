    "url": "https://crepe.moe/c/WTv4TOcq.zip",
    "pre_install": [
        "if (!(Test-Path \"$persist_dir\\cfg.ini\")) { New-Item \"$dir\\cfg.ini\" | Out-Null }",
        "if (!(Test-Path \"$persist_dir\\cfg.json\")) { New-Item \"$dir\\cfg.json\" | Out-Null }",
        "if (!(Test-Path \"$persist_dir\\imgui.ini\")) { New-Item \"$dir\\imgui.ini\" | Out-Null }"
    ],
    "shortcuts": [
        [
            "injector.exe",
            "Akebi-GC"
        ]
    ],
    "persist": [
        "cfg.ini",
        "cfg.json",
        "imgui.ini"
    ]
}
