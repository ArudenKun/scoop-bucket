{
    "version": "2022.2.5-222.4345.5",
    "description": "Cross-Platform IDE for Databases & SQL by JetBrains.",
    "homepage": "https://www.jetbrains.com/datagrip/",
    "license": {
        "identifier": "Proprietary",
        "url": "https://www.jetbrains.com/store/license.html"
    },
    "depends": "custom/ja-netfilter",
    "notes": "Get key here: 'https://3.jetbra.in'",
    "url": "https://download.jetbrains.com/datagrip/datagrip-2022.2.5.win.zip",
    "hash": "17541e98f1b49d2bd00dcc4a4fcaffab7c8ebb1616accc965dc6331a98b94854",
    "extract_to": "IDE",
    "installer": {
        "script": [
            "& \"$bucketsdir\\extras\\scripts\\jetbrains\\portable.ps1\" $dir $persist_dir",
            "if (!(Test-Path \"$persist_dir\\datagrip64.exe.vmoptions\")) {",
            "   Add-Content $dir\\IDE\\bin\\datagrip64.exe.vmoptions -Value \"-javaagent:$scoopdir\\apps\\ja-netfilter\\current\\ja-netfilter.jar=jetbrains\"",
            "   Add-Content $dir\\IDE\\bin\\datagrip64.exe.vmoptions -Value \"--add-opens=java.base/jdk.internal.org.objectweb.asm=ALL-UNNAMED\"",
            "   Add-Content $dir\\IDE\\bin\\datagrip64.exe.vmoptions -Value \"--add-opens=java.base/jdk.internal.org.objectweb.asm.tree=ALL-UNNAMED\"",
            "}"
        ]
    },
    "bin": [
        [
            "IDE\\bin\\datagrip64.exe",
            "datagrip"
        ]
    ],
    "shortcuts": [
        [
            "IDE\\bin\\datagrip64.exe",
            "JetBrains\\DataGrip"
        ]
    ],
    "persist": [
        "IDE\\bin\\idea.properties",
        "IDE\\bin\\datagrip64.exe.vmoptions",
        "profile"
    ],
    "checkver": {
        "url": "https://data.services.jetbrains.com/products/releases?code=DG&latest=true&platform=zip&type=release",
        "regex": "version\":\"(?<ver>[\\d.]+)\".*\"build\":\"(?<build>[\\d.]+)\"",
        "replace": "${ver}-${build}"
    },
    "autoupdate": {
        "url": "https://download.jetbrains.com/datagrip/datagrip-$matchHead.win.zip",
        "hash": {
            "url": "$url.sha256"
        }
    }
}
