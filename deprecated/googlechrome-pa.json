{
    "version": "109.0.5414.129",
    "homepage": "https://portableapps.com/apps/internet/google_chrome_portable",
    "description": "Browser",
    "license": "",
    "url": [
        "https://portableapps.com/redirect/?a=GoogleChromePortable&s=s&d=pa&f=GoogleChromePortable_109.0.5414.129_online.paf.exe#/Portable.7z",
        "https://dl.google.com/release2/chrome/juzaykgd5e6nyvk27fwtbrjgoa_109.0.5414.129/109.0.5414.129_chrome_installer.exe#/ChromeBinary.7z"
    ],
    "hash": [
        "3b99e11fd618a32391c9a9a695ca124c69084d686f86f8fcf099d1de978218aa",
        "4441c778f7f4b91df40350dff2b37fd4afb81a0165239ec1dd5f750834f1b54a"
    ],
    "installer": {
        "script": [
            "Expand-7zipArchive \"$dir\\chrome.7z\" \"$dir\\App\\Chrome-bin\" -ExtractDir 'Chrome-bin' -Removal",
            "Rename-Item \"$dir\\GoogleChromePortable.exe\" \"$dir\\chrome.exe\""
        ]
    },
    "bin": [
        [
            "chrome.exe",
            "chrome"
        ]
    ],
    "shortcuts": [
        [
            "chrome.exe",
            "Google Chrome"
        ]
    ],
    "persist": "Data",
    "post_install": [
        "if (!(Test-Path \"$persist_dir\\Data\")) { New-Item \"$dir\\Data\" -ItemType Directory | Out-Null }",
        "if (!(Test-Path \"$persist_dir\\Data\\profile\")) { New-Item \"$dir\\Data\\profile\" -ItemType Directory | Out-Null }",
        "if (!(Test-Path \"$dir\\Data\\profile\\*\") -and (Test-Path \"$env:LocalAppData\\Google\\Chrome\\User Data\")) {",
        "    info '[Portable Mode]: Copying user data...'",
        "    Copy-Item \"$env:LocalAppData\\Google\\Chrome\\User Data\\*\" \"$dir\\Data\\profile\" -Recurse",
        "}",
        "Remove-Item \"$dir\\`$PLUGINSDIR\" -Recurse",
        "Remove-Item \"$dir\\7zTemp\" -Recurse"
    ],
    "env_set": {
        "CHROME_EXECUTABLE": "$dir\\chrome.exe"
    },
    "checkver": {
        "url": "https://scoopinstaller.github.io/UpdateTracker/googlechrome/chrome.min.xml",
        "regex": "(?sm)<stable32><version>(?<version>[\\d.]+)</version>.+release2/chrome/(?<32>[\\w-]+)_.+<stable64>.+release2/chrome/(?<64>[\\w-]+)_.+</stable64>"
    },
    "autoupdate": {
        "url": [
            "https://portableapps.com/redirect/?a=GoogleChromePortable&s=s&d=pa&f=GoogleChromePortable_$version_online.paf.exe#/Portable.7z",
            "https://dl.google.com/release2/chrome/$match64_$version/$version_chrome_installer.exe#/ChromeBinary.7z"
        ],
        "hash": [
            {
                "url": "https://portableapps.com/apps/internet/google_chrome_portable",
                "regex": ": $sha256"
            },
            {
                "url": "https://scoopinstaller.github.io/UpdateTracker/googlechrome/chrome.min.xml",
                "xpath": "/chromechecker/stable64[version='$version']/sha256"
            }
        ]
    }
}
